      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\nbody{font-family:'Hanken Grotesk',sans-serif;background:#CFE8D6;color:#121210}.display{font-family:'Archivo',sans-serif;letter-spacing:-.025em}.mono{font-family:'Space Mono',monospace;font-variant-numeric:tabular-nums}.hard{border:2px solid #121210;box-shadow:4px 4px 0 #121210}.hard-strong{border:3px solid #121210;box-shadow:5px 5px 0 #121210}.eyebrow{font:700 10px 'Space Mono',monospace;letter-spacing:.12em;text-transform:uppercase}.pill{border:1.5px solid #121210;font:700 10px 'Space Mono',monospace;letter-spacing:.045em;text-transform:uppercase}.focusable:focus-visible{outline:3px solid #2E8C42;outline-offset:3px}.state-skeleton{background:linear-gradient(90deg,#e8eee8 20%,#f6f8f5 38%,#e8eee8 60%);background-size:220% 100%;animation:shine 1.4s linear infinite}@keyframes shine{to{background-position-x:-220%}}@media(max-width:900px){.app-shell{display:block!important}.sidebar{display:none!important}.content-grid{grid-template-columns:1fr!important}.state-grid{grid-template-columns:1fr!important}.header-inner{align-items:flex-start!important;flex-direction:column!important}.feed-card{grid-template-columns:1fr!important}.count-box{min-width:0!important}.detail-side{position:static!important}.mobile-nav{display:flex!important}}@media(max-width:580px){.page-wrap{padding:18px!important}.search-box{width:100%!important}.metric-row{grid-template-columns:1fr 1fr!important}.feed-heading{align-items:flex-start!important;flex-direction:column!important}}\n</style>\n<div class=\"app-shell flex min-h-screen\" data-kid=\"1\" data-name=\"app shell layout container\">\n    <aside class=\"sidebar w-[250px] shrink-0 border-r-[3px] border-[#121210] bg-[#CFE8D6] px-5 py-6 flex flex-col\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex items-center gap-3 mb-10\" data-kid=\"1-1-1\" data-name=\"brand logo block\">\n            <div class=\"hard-strong w-12 h-12 bg-[#2E8C42] text-white flex items-center justify-center text-2xl\" data-kid=\"1-1-1-1\" data-name=\"brand icon tile\">\n                <i class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1\" data-name=\"civic building icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand name block\">\n                <div class=\"display font-extrabold text-xl leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"brand name heading\">\n                    NAGARSEVA\n                </div>\n                <div class=\"mono text-[9px] tracking-[.16em] opacity-60 mt-1\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline text\">\n                    CITIZEN PORTAL\n                </div>\n            </div>\n        </div>\n        <div class=\"eyebrow opacity-50 px-2 mb-3\" data-kid=\"1-1-2\" data-name=\"city section label\">\n            Your city\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"flex flex-col gap-3\" data-kid=\"1-1-3\" data-name=\"main navigation\">\n            <a class=\"focusable hard bg-white flex items-center gap-3 px-3 py-3 font-semibold\" data-kid=\"1-1-3-1\" data-name=\"home navigation link\" href=\"#home\">\n                <i class=\"ti ti-home text-xl\" data-kid=\"1-1-3-1-1\" data-name=\"home icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"home navigation label\">\n                    Home\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"focusable hard-strong bg-[#121210] text-white flex items-center justify-between px-3 py-3 font-semibold\" data-kid=\"1-1-3-2\" data-name=\"active issue tracker navigation link\" href=\"#issues\">\n                <span class=\"flex items-center gap-3\" data-kid=\"1-1-3-2-1\" data-name=\"issue tracker nav label with search icon\">\n                    <i class=\"ti ti-list-search text-xl\" data-kid=\"1-1-3-2-1-1\" data-name=\"search list icon\">\n                    </i>\n                    Issue tracker\n                </span>\n                <span class=\"mono text-xs bg-[#E8A030] text-[#121210] px-2 py-1\" data-kid=\"1-1-3-2-2\" data-name=\"open issues count badge\">\n                    24\n                </span>\n            </a>\n            <a class=\"focusable hard bg-white flex items-center gap-3 px-3 py-3 font-semibold\" data-kid=\"1-1-3-3\" data-name=\"report issue navigation link\" href=\"#report\">\n                <i class=\"ti ti-camera-plus text-xl\" data-kid=\"1-1-3-3-1\" data-name=\"camera add icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"report issue navigation label\">\n                    Report an issue\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-9 hard bg-white p-4\" data-kid=\"1-1-4\" data-name=\"community pulse stat card\">\n            <div class=\"eyebrow opacity-55\" data-kid=\"1-1-4-1\" data-name=\"community pulse card label\">\n                Community pulse\n            </div>\n            <div class=\"flex items-end gap-2 mt-2\" data-kid=\"1-1-4-2\" data-name=\"resolution percentage display\">\n                <span class=\"mono font-bold text-3xl\" data-kid=\"1-1-4-2-1\" data-name=\"resolution percentage number\">\n                    68%\n                </span>\n                <span class=\"text-xs opacity-60 mb-1\" data-kid=\"1-1-4-2-2\" data-name=\"percentage context caption\">\n                    resolved this month\n                </span>\n            </div>\n            <div class=\"mt-3 h-3 border-2 border-[#121210] flex\" data-kid=\"1-1-4-3\" data-name=\"segmented status progress bar\">\n                <span class=\"bg-[#2E8C42] w-[68%]\" data-kid=\"1-1-4-3-1\" data-name=\"resolved status bar segment\">\n                </span>\n                <span class=\"bg-[#E8A030] w-[20%]\" data-kid=\"1-1-4-3-2\" data-name=\"in-progress status bar segment\">\n                </span>\n                <span class=\"bg-[#C03A3A] w-[12%]\" data-kid=\"1-1-4-3-3\" data-name=\"open status bar segment\">\n                </span>\n            </div>\n            <div class=\"flex justify-between mono text-[9px] opacity-55 mt-2\" data-kid=\"1-1-4-4\" data-name=\"status bar legend\">\n                <span data-kid=\"1-1-4-4-1\" data-name=\"resolved legend item\">\n                    RESOLVED 68%\n                </span>\n                <span data-kid=\"1-1-4-4-2\" data-name=\"open legend item\">\n                    OPEN 12%\n                </span>\n            </div>\n        </div>\n        <div class=\"mt-auto pt-8\" data-kid=\"1-1-5\" data-name=\"sidebar bottom actions group\">\n            <div class=\"eyebrow opacity-50 px-2 mb-2\" data-kid=\"1-1-5-1\" data-name=\"service area label\">\n                Service area\n            </div>\n            <button class=\"focusable hard bg-white w-full flex items-center justify-between px-3 py-3 text-left\" data-kid=\"1-1-5-2\" data-name=\"service area selector button\">\n                <span class=\"flex items-center gap-2 font-semibold\" data-kid=\"1-1-5-2-1\" data-name=\"selected service area with pin icon\">\n                    <i class=\"ti ti-map-pin text-lg text-[#2E8C42]\" data-kid=\"1-1-5-2-1-1\" data-name=\"map pin icon\">\n                    </i>\n                    Ranchi, Jharkhand\n                </span>\n                <i class=\"ti ti-chevron-down\" data-kid=\"1-1-5-2-2\" data-name=\"chevron down indicator icon\">\n                </i>\n            </button>\n            <div class=\"flex items-center gap-3 mt-6 pt-4 border-t-2 border-[#121210]/25\" data-kid=\"1-1-5-3\" data-name=\"account profile row\">\n                <div class=\"w-10 h-10 bg-[#E8A030] border-2 border-[#121210] flex items-center justify-center font-bold\" data-kid=\"1-1-5-3-1\" data-name=\"avatar initials circle\">\n                    A\n                </div>\n                <div data-kid=\"1-1-5-3-2\" data-name=\"account identity block\">\n                    <div class=\"font-bold text-sm\" data-kid=\"1-1-5-3-2-1\" data-name=\"account holder name\">\n                        Ananya Kumar\n                    </div>\n                    <div class=\"mono text-[9px] opacity-55\" data-kid=\"1-1-5-3-2-2\" data-name=\"account type label\">\n                        CITIZEN ACCOUNT\n                    </div>\n                </div>\n                <i class=\"ti ti-dots-vertical ml-auto\" data-kid=\"1-1-5-3-3\" data-name=\"vertical menu dots icon\">\n                </i>\n            </div>\n        </div>\n    </aside>\n    <main class=\"min-w-0 flex-1\" data-kid=\"1-2\" data-name=\"main content area\">\n        <header class=\"header-inner border-b-[3px] border-[#121210] px-8 py-5 flex items-center justify-between gap-6\" data-kid=\"1-2-1\" data-name=\"page header with title and actions\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <div class=\"eyebrow opacity-50\" data-kid=\"1-2-1-1-1\" data-name=\"page breadcrumb label\">\n                    NagarSeva / Public dashboard\n                </div>\n                <h1 class=\"display font-extrabold text-3xl mt-1\" data-kid=\"1-2-1-1-2\" data-name=\"page main heading\">\n                    Issue tracker\n                </h1>\n                <div class=\"mono text-[10px] opacity-55 mt-1\" data-kid=\"1-2-1-1-3\" data-name=\"page subtitle with update timestamp\">\n                    YOUR NEIGHBOURHOOD, BETTER TOGETHER · UPDATED 2 MIN AGO\n                </div>\n            </div>\n            <div class=\"flex gap-3 items-center\" data-kid=\"1-2-1-2\" data-name=\"header actions group\">\n                <label class=\"search-box hard bg-white flex items-center gap-2 px-3 h-11 w-[300px]\" data-kid=\"1-2-1-2-1\" data-name=\"search input box\">\n                    <i class=\"ti ti-search text-lg\" data-kid=\"1-2-1-2-1-1\" data-name=\"search magnifier icon\">\n                    </i>\n                    <input aria-label=\"Search issues\" class=\"bg-transparent min-w-0 flex-1 text-sm outline-none\" data-kid=\"1-2-1-2-1-2\" data-name=\"search text input field\" placeholder=\"Search issue or location…\"/>\n                    <kbd class=\"mono border border-[#121210] px-1 text-[9px]\" data-kid=\"1-2-1-2-1-3\" data-name=\"keyboard shortcut key hint\">\n                        ⌘ K\n                    </kbd>\n                </label>\n                <button class=\"focusable hard-strong bg-[#121210] text-white px-4 h-11 font-bold whitespace-nowrap\" data-kid=\"1-2-1-2-2\" data-name=\"primary report issue button\">\n                    <i class=\"ti ti-plus mr-1\" data-kid=\"1-2-1-2-2-1\" data-name=\"plus icon\">\n                    </i>\n                    Report issue\n                </button>\n            </div>\n        </header>\n        <div class=\"page-wrap p-8 max-w-[1450px] mx-auto\" data-kid=\"1-2-2\" data-name=\"page content wrap\">\n            <section aria-label=\"Issue summary\" class=\"metric-row grid grid-cols-4 gap-4 mb-7\" data-kid=\"1-2-2-1\" data-name=\"issue summary metrics row\">\n                <div class=\"hard bg-white p-4\" data-kid=\"1-2-2-1-1\" data-name=\"reported issues metric card\">\n                    <div class=\"eyebrow opacity-50\" data-kid=\"1-2-2-1-1-1\" data-name=\"reported issues metric label\">\n                        Reported issues\n                    </div>\n                    <div class=\"flex items-end justify-between mt-2\" data-kid=\"1-2-2-1-1-2\" data-name=\"reported issues metric value row\">\n                        <strong class=\"display text-3xl font-extrabold\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"reported issues count number\">\n                            1,284\n                        </strong>\n                        <span class=\"mono text-[10px] text-[#2E8C42] font-bold\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"week trend badge\">\n                            +8 THIS WK\n                        </span>\n                    </div>\n                </div>\n                <div class=\"hard bg-[#2E8C42] text-white p-4\" data-kid=\"1-2-2-1-2\" data-name=\"open issues metric card\">\n                    <div class=\"eyebrow opacity-75\" data-kid=\"1-2-2-1-2-1\" data-name=\"open issues metric label\">\n                        Open\n                    </div>\n                    <div class=\"flex items-end justify-between mt-2\" data-kid=\"1-2-2-1-2-2\" data-name=\"open issues metric value row\">\n                        <strong class=\"display text-3xl font-extrabold\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"open issues count number\">\n                            24\n                        </strong>\n                        <span class=\"mono text-[10px]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"needs attention caption\">\n                            NEEDS ATTENTION\n                        </span>\n                    </div>\n                </div>\n                <div class=\"hard bg-[#E8A030] p-4\" data-kid=\"1-2-2-1-3\" data-name=\"in progress metric card\">\n                    <div class=\"eyebrow opacity-65\" data-kid=\"1-2-2-1-3-1\" data-name=\"in progress metric label\">\n                        In progress\n                    </div>\n                    <div class=\"flex items-end justify-between mt-2\" data-kid=\"1-2-2-1-3-2\" data-name=\"in progress metric value row\">\n                        <strong class=\"display text-3xl font-extrabold\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"in progress count number\">\n                            16\n                        </strong>\n                        <span class=\"mono text-[10px]\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"being fixed caption\">\n                            BEING FIXED\n                        </span>\n                    </div>\n                </div>\n                <div class=\"hard bg-white p-4\" data-kid=\"1-2-2-1-4\" data-name=\"closed monthly metric card\">\n                    <div class=\"eyebrow opacity-50\" data-kid=\"1-2-2-1-4-1\" data-name=\"closed monthly metric label\">\n                        Closed this month\n                    </div>\n                    <div class=\"flex items-end justify-between mt-2\" data-kid=\"1-2-2-1-4-2\" data-name=\"closed monthly metric value row\">\n                        <strong class=\"display text-3xl font-extrabold\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"closed monthly count number\">\n                            57\n                        </strong>\n                        <span class=\"mono text-[10px] text-[#2E8C42] font-bold\" data-kid=\"1-2-2-1-4-2-2\" data-name=\"positive trend badge\">\n                            +12% ↗\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <div class=\"content-grid grid grid-cols-[minmax(0,1.6fr)_minmax(280px,.8fr)] gap-6 items-start\" data-kid=\"1-2-2-2\" data-name=\"content grid with issue feed and sidebar\">\n                <section data-kid=\"1-2-2-2-1\" data-name=\"issue feed section\" id=\"issues\">\n                    <div class=\"feed-heading flex items-end justify-between gap-4 mb-4\" data-kid=\"1-2-2-2-1-1\" data-name=\"feed heading row\">\n                        <div data-kid=\"1-2-2-2-1-1-1\" data-name=\"feed title block\">\n                            <div class=\"eyebrow opacity-50\" data-kid=\"1-2-2-2-1-1-1-1\" data-name=\"feed section label\">\n                                Neighbourhood reports\n                            </div>\n                            <h2 class=\"display text-2xl font-bold mt-1\" data-kid=\"1-2-2-2-1-1-1-2\" data-name=\"recent issues heading\">\n                                Recent issues\n                                <span class=\"mono te
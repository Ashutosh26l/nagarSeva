mt-3\" data-kid=\"1-2-2-2-1-5-1-5\" data-name=\"issue action buttons row\">\n                                <button aria-label=\"Upvote this issue, 14 votes\" class=\"focusable hard bg-white px-3 py-1.5 font-bold text-sm\" data-kid=\"1-2-2-2-1-5-1-5-1\" data-name=\"upvote support button\">\n                                    <i class=\"ti ti-arrow-big-up mr-1\" data-kid=\"1-2-2-2-1-5-1-5-1-1\" data-name=\"up arrow icon\">\n                                    </i>\n                                    14 support\n                                </button>\n                                <button class=\"focusable font-bold text-sm underline underline-offset-4\" data-kid=\"1-2-2-2-1-5-1-5-2\" data-name=\"view details button\">\n                                    View details\n                                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-1-5-1-5-2-1\" data-name=\"external link arrow icon\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"count-box self-center border-l-2 border-[#121210]/20 pl-4 text-center\" data-kid=\"1-2-2-2-1-5-2\" data-name=\"resolved status box\">\n                            <div class=\"eyebrow opacity-45\" data-kid=\"1-2-2-2-1-5-2-1\" data-name=\"resolved label\">\n                                Resolved\n                            </div>\n                            <i class=\"ti ti-circle-check text-3xl text-[#2E8C42] mt-2\" data-kid=\"1-2-2-2-1-5-2-2\" data-name=\"verified checkmark icon\">\n                            </i>\n                            <div class=\"mono text-[9px] opacity-50\" data-kid=\"1-2-2-2-1-5-2-3\" data-name=\"verified label\">\n                                VERIFIED\n                            </div>\n                        </div>\n                    </article>\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-1-6\" data-name=\"pagination controls row\">\n                        <span class=\"mono text-[10px] opacity-50\" data-kid=\"1-2-2-2-1-6-1\" data-name=\"results count text\">\n                            SHOWING 3 OF 24 REPORTS\n                        </span>\n                        <button class=\"focusable hard bg-white px-4 py-2 font-bold text-sm\" data-kid=\"1-2-2-2-1-6-2\" data-name=\"load more button\">\n                            Load more\n                            <i class=\"ti ti-arrow-down ml-1\" data-kid=\"1-2-2-2-1-6-2-1\" data-name=\"down arrow icon\">\n                            </i>\n                        </button>\n                    </div>\n                </section>\n                <aside class=\"detail-side\" data-kid=\"1-2-2-2-2\" data-name=\"detail sidebar\">\n                    <section class=\"hard-strong bg-[#121210] text-white p-5 mb-5\" data-kid=\"1-2-2-2-2-1\" data-name=\"how it works card\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"how it works header row\">\n                            <span class=\"eyebrow text-[#CFE8D6]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"how it works label\">\n                                How it works\n                            </span>\n                            <i class=\"ti ti-route text-2xl text-[#E8A030]\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"route icon\">\n                            </i>\n                        </div>\n                        <h2 class=\"display text-xl font-bold mt-2\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"how it works heading\">\n                            From report to resolution\n                        </h2>\n                        <div class=\"mt-4 flex flex-col gap-3\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"process steps list\">\n                            <div class=\"flex gap-3 items-center\" data-kid=\"1-2-2-2-2-1-3-1\" data-name=\"step one row\">\n                                <span class=\"w-8 h-8 bg-[#CFE8D6] text-[#121210] flex items-center justify-center font-bold\" data-kid=\"1-2-2-2-2-1-3-1-1\" data-name=\"step one number badge\">\n                                    1\n                                </span>\n                                <span class=\"text-sm\" data-kid=\"1-2-2-2-2-1-3-1-2\" data-name=\"step one description\">\n                                    Neighbours report an issue\n                                </span>\n                            </div>\n                            <div class=\"h-4 border-l-2 border-dashed border-white/35 ml-4\" data-kid=\"1-2-2-2-2-1-3-2\" data-name=\"step connector line\">\n                            </div>\n                            <div class=\"flex gap-3 items-center\" data-kid=\"1-2-2-2-2-1-3-3\" data-name=\"step two row\">\n                                <span class=\"w-8 h-8 bg-[#E8A030] text-[#121210] flex items-center justify-center font-bold\" data-kid=\"1-2-2-2-2-1-3-3-1\" data-name=\"step two number badge\">\n                                    2\n                                </span>\n                                <span class=\"text-sm\" data-kid=\"1-2-2-2-2-1-3-3-2\" data-name=\"step two description\">\n                                    Teams review and take action\n                                </span>\n                            </div>\n                            <div class=\"h-4 border-l-2 border-dashed border-white/35 ml-4\" data-kid=\"1-2-2-2-2-1-3-4\" data-name=\"step connector line\">\n                            </div>\n                            <div class=\"flex gap-3 items-center\" data-kid=\"1-2-2-2-2-1-3-5\" data-name=\"step three row\">\n                                <span class=\"w-8 h-8 bg-[#2E8C42] text-white flex items-center justify-center font-bold\" data-kid=\"1-2-2-2-2-1-3-5-1\" data-name=\"step three success badge\">\n                                    <i class=\"ti ti-check\" data-kid=\"1-2-2-2-2-1-3-5-1-1\" data-name=\"checkmark icon\">\n                                    </i>\n                                </span>\n                                <span class=\"text-sm\" data-kid=\"1-2-2-2-2-1-3-5-2\" data-name=\"step three description\">\n                                    Everyone sees the update\n                                </span>\n                            </div>\n                        </div>\n                        <button class=\"focusable w-full mt-5 bg-[#E8A030] text-[#121210] py-3 font-bold\" data-kid=\"1-2-2-2-2-1-4\" data-name=\"report CTA button\">\n                            Report a local issue\n                            <i class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-2-2-2-2-1-4-1\" data-name=\"external link arrow icon\">\n                            </i>\n                        </button>\n                    </section>\n                    <section class=\"hard bg-white p-4 mb-5\" data-kid=\"1-2-2-2-2-2\" data-name=\"most supported issue card\">\n                        <div class=\"flex justify-between items-center\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"top issue header\">\n                            <div data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"top issue title block\">\n                                <div class=\"eyebrow opacity-45\" data-kid=\"1-2-2-2-2-2-1-1-1\" data-name=\"most supported label\">\n                                    Most supported\n                                </div>\n                                <h3 class=\"display text-lg font-bold mt-1\" data-kid=\"1-2-2-2-2-2-1-1-2\" data-name=\"most supported issue title\">\n                                    Clean water for all\n                                </h3>\n                            </div>\n                            <span class=\"pill bg-[#CFE8D6] px-2 py-1\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"issue status pill\">\n                                OPEN\n                            </span>\n                        </div>\n                        <p class=\"text-sm opacity-65 mt-2\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"issue supporting description\">\n                            Residents of Bariatu are asking for consistent water supply during morning hours.\n                        </p>\n                        <div class=\"flex justify-between items-center mt-3 pt-3 border-t border-[#121210]/20\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"support count footer\">\n                            <span class=\"mono text-xs\" data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"support total with up arrow\">\n                                <i class=\"ti ti-arrow-big-up text-[#2E8C42]\" data-kid=\"1-2-2-2-2-2-3-1-1\" data-name=\"up arrow icon\">\n                                </i>\n                                86 SUPPORT\n                            </span>\n                            <span class=\"mono text-[9px] opacity-50\" data-kid=\"1-2-2-2-2-2-3-2\" data-name=\"location and time caption\">\n                                BARIATU · 3D AGO\n                            </span>\n                        </div>\n                    </section>\n                    <section class=\"hard bg-[#E8A030] p-4\" data-kid=\"1-2-2-2-2-3\" data-name=\"call-to-action card\">\n                        <div class=\"eyebrow\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"call-to-action label\">\n                            Your voice matters\n                        </div>\n                        <p class=\"display font-bold text-lg mt-2\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"call-to-action headline\">\n                            See something that needs fixing?\n                        </p>\n                        <button class=\"focusable hard bg-white w-full mt-3 py-2 font-bold\" data-kid=\"1-2-2-2-2-3-3\" data-name=\"start report button\">\n                            Start a report\n                            <i class=\"ti ti-arrow-right ml-1\" data-kid=\"1-2-2-2-2-3-3-1\" data-name=\"right arrow icon\">\n                            </i>\n                        </button>\n                    </section>\n                </aside>\n            </div>\n            <section class=\"mt-8 border-t-[3px] border-[#121210] pt-5\" data-kid=\"1-2-2-3\" data-name=\"interface states section\">\n                <div class=\"flex items-end justify-between mb-3\" data-kid=\"1-2-2-3-1\" data-name=\"interface states header row\">\n                    <div data-kid=\"1-2-2-3-1-1\" data-name=\"interface states title block\">\n                        <div class=\"eyebrow opacity-50\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"interface states label\">\n                            Interface states\n                        </div>\n                        <h2 class=\"display text-lg font-bold mt-1\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"interface states heading\">\n                            Loading · Empty · Error\n                        </h2>\n                    </div>\n                    <span class=\"mono text-[9px] opacity-45\" data-kid=\"1-2-2-3-1-2\" data-name=\"example components caption\">\n                        EXAMPLE COMPONENTS\n                    </span>\n                </div>\n                <div class=\"state-grid grid grid-cols-3 gap-4\" data-kid=\"1-2-2-3-2\" data-name=\"state grid\">\n                    <div class=\"hard bg-white p-4\" data-kid=\"1-2-2-3-2-1\" data-name=\"loading state example card\">\n                        <div class=\"eyebrow opacity-50 mb-3\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"loading state label\">\n                            Loading feed\n                        </div>\n                        <div class=\"flex gap-3\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"loading skeleton row\">\n                            <div class=\"state-skeleton w-10 h-10 border border-[#121210]/20\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"skeleton avatar placeholder\" data-reason=\"background-position animated by infinite CSS shine keyframes\">\n                            </div>\n                            <div class=\"flex-1\" data-kid=\"1-2-2-3-2-1-2-2\" data-name=\"skeleton lines group\">\n                                <div class=\"state-skeleton h-3 w-1/3 mb-2\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-1-2-2-1\" data-name=\"skeleton short line\" data-reason=\"background-position animated by infinite CSS shine keyframes\">\n                                </div>\n                                <div class=\"state-skeleton h-4 w-3/4 mb-2\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-1-2-2-2\" data-name=\"skeleton wide line\" data-reason=\"background-position animated by infinite CSS shine keyframes\">\n                                </div>\n                                <div class=\"state-skeleton h-3 w-1/2\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-1-2-2-3\" data-name=\"skeleton medium line\" data-reason=\"background-position animated by infinite CSS shine keyframes\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"hard bg-white p-4\" data-kid=\"1-2-2-3-2-2\" data-name=\"empty state example card\">\n                        <div class=\"eyebrow opacity-50 mb-2\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"empty state label\">\n                            Empty feed\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"empty state message row\">\n                            <div class=\"w-10 h-10 border-2 border-[#121210] bg-[#CFE8D6] flex items-center justify-center text-xl\" data-kid=\"1-2-2-3-2-2-2-1\" data-name=\"empty state icon tile\">\n                                <i class=\"ti ti-mood-empty\" data-kid=\"1-2-2-3-2-2-2-1-1\" data-name=\"empty mood icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-2-2-3-2-2-2-2\" data-name=\"empty state message block\">\n                                <div class=\"font-bold\" data-kid=\"1-2-2-3-2-2-2-2-1\" data-name=\"empty state headline\">\n                                    No issues found\n                                </div>\n                                <div class=\"text-xs opacity-60\" data-kid=\"1-2-2-3-2-2-2-2-2\" data-name=\"empty state hint text\">\n                                    Try a different category or area.\n                                </div>\n                            </div>\n                            <button class=\"focusable ml-auto mono text-[10px] underline\" data-kid=\"1-2-2-3-2-2-2-3\" data-name=\"clear filters button\">\n                                Clear filters\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"hard bg-[#F8E3E0] p-4\" data-kid=\"1-2-2-3-2-3\" data-name=\"error state example card\">\n                        <div class=\"eyebrow text-[#C03A3A] mb-2\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"error state label\">\n                            Could not load issues\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"error message row\">\n                            <i class=\"ti ti-alert-triangle text-2xl text-[#C03A3A]\" data-kid=\"1-2-2-3-2-3-2-1\" data-name=\"warning triangle icon\">\n                            </i>\n                            <div class=\"flex-1 text-xs\" data-kid=\"1-2-2-3-2-3-2-2\" data-name=\"error message text\">\n                                Check your connection and try again.\n                            </div>\n                            <button class=\"focusable hard bg-white px-3 py-2 font-bold text-xs\" data-kid=\"1-2-2-3-2-3-2-3\" data-name=\"retry button\">\n                                Retry\n                                <i class=\"ti ti-refresh\" data-kid=\"1-2-2-3-2-3-2-3-1\" data-name=\"refresh icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <footer class=\"flex items-center justify-between mt-7 pt-4 border-t-2 border-[#121210]/25\" data-kid=\"1-2-2-4\" data-name=\"page footer\">\n                <div class=\"mono text-[9px] opacity-45\" data-kid=\"1-2-2-4-1\" data-name=\"footer brand text\">\n                    NAGARSEVA · CITIZEN ISSUE TRACKER\n                </div>\n                <div class=\"flex gap-4 text-xs opacity-60\" data-kid=\"1-2-2-4-2\" data-name=\"footer links group\">\n                    <a class=\"focusable underline\" data-kid=\"1-2-2-4-2-1\" data-name=\"help and support link\" href=\"#help\">\n                        Help & support\n                    </a>\n                    <a class=\"focusable underline\" data-kid=\"1-2-2-4-2-2\" data-name=\"privacy link\" href=\"#privacy\">\n                        Privacy\n                    </a>\n                </div>\n            </footer>\n        </div>\n        <nav class=\"mobile-nav hidden fixed bottom-0 left-0 right-0 bg-[#CFE8D6] border-t-[3px] border-[#121210] px-2 py-2 justify-around z-50\" data-kid=\"1-2-3\" data-name=\"mobile bottom navigation bar\">\n            <a class=\"focusable flex flex-col items-center text-xs\" data-kid=\"1-2-3-1\" data-name=\"mobile home nav link\" href=\"#home\">\n                <i class=\"ti ti-home text-xl\" data-kid=\"1-2-3-1-1\" data-name=\"home icon\">\n                </i>\n                Home\n            </a>\n            <a class=\"focusable flex flex-col items-center text-xs font-bold\" data-kid=\"1-2-3-2\" data-name=\"mobile issues nav link\" href=\"#issues\">\n                <i class=\"ti ti-list-search text-xl\" data-kid=\"1-2-3-2-1\" data-name=\"search list icon\">\n                </i>\n                Issues\n            </a>\n            <a class=\"focusable flex flex-col items-center text-xs\" data-kid=\"1-2-3-3\" data-name=\"mobile report nav link\" href=\"#report\">\n                <i class=\"ti ti-camera-plus text-xl\" data-kid=\"1-2-3-3-1\" data-name=\"camera add icon\">\n                </i>\n                Report\n            </a>\n        </nav>\n    </main>\n</div>\n",

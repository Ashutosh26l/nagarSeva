    "var_49c3abd0a17b": {
      "type": "variant",
      "label": "NagarSeva — Sign In",
      "parentId": "b6e2efe4-6321-49ce-a8ea-3ccc4ecacd2a",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\nbody{font-family:'Hanken Grotesk',sans-serif;background:#CFE8D6;color:#121210}.font-display{font-family:'Archivo',sans-serif;letter-spacing:-.02em}.font-mono{font-family:'Space Mono',monospace;font-variant-numeric:tabular-nums}.outline-card{border:3px solid #121210;box-shadow:6px 6px 0 #121210}.hard-shadow{box-shadow:4px 4px 0 #121210}.paper-grid{background-image:linear-gradient(rgba(18,18,16,.065) 1px,transparent 1px),linear-gradient(90deg,rgba(18,18,16,.065) 1px,transparent 1px);background-size:24px 24px}\n</style>\n<div class=\"min-h-[100dvh] bg-[#CFE8D6] flex flex-col\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"h-[82px] border-b-[3px] border-[#121210] px-6 md:px-10 flex items-center justify-between bg-[#CFE8D6]\" data-kid=\"1-1\" data-name=\"top header bar\">\n        <a aria-label=\"NagarSeva home\" class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            <span class=\"w-11 h-11 bg-[#2E8C42] border-[3px] border-[#121210] shadow-[3px_3px_0_#121210] flex items-center justify-center text-white text-2xl\" data-kid=\"1-1-1-1\" data-name=\"logo badge container\">\n                <i class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1\" data-name=\"community building icon\">\n                </i>\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name block\">\n                <span class=\"block font-display text-[19px] leading-none font-extrabold tracking-tight\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    NAGARSEVA\n                </span>\n                <span class=\"font-mono text-[9px] tracking-[.22em] opacity-65\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline text\">\n                    CITIZEN ISSUE DESK\n                </span>\n            </span>\n        </a>\n        <nav aria-label=\"Main navigation\" class=\"hidden sm:flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n            <a class=\"min-h-11 px-4 flex items-center gap-2 border-2 border-transparent font-display font-semibold hover:border-[#121210]\" data-kid=\"1-1-2-1\" data-name=\"home navigation link\" href=\"#\">\n                <i class=\"ti ti-home text-lg\" data-kid=\"1-1-2-1-1\" data-name=\"home icon\">\n                </i>\n                Home\n            </a>\n            <a class=\"min-h-11 px-4 flex items-center gap-2 border-2 border-transparent font-display font-semibold hover:border-[#121210]\" data-kid=\"1-1-2-2\" data-name=\"issue list navigation link\" href=\"#\">\n                <i class=\"ti ti-list-details text-lg\" data-kid=\"1-1-2-2-1\" data-name=\"list icon\">\n                </i>\n                Issue List\n            </a>\n            <a class=\"min-h-11 px-4 flex items-center gap-2 border-[3px] border-[#121210] bg-[#121210] text-white font-display font-bold\" data-kid=\"1-1-2-3\" data-name=\"login navigation link\" href=\"#\">\n                <i class=\"ti ti-login-2 text-lg\" data-kid=\"1-1-2-3-1\" data-name=\"login icon\">\n                </i>\n                Login\n            </a>\n        </nav>\n        <div aria-label=\"Open navigation\" class=\"sm:hidden w-11 h-11 border-2 border-[#121210] flex items-center justify-center text-xl\" data-kid=\"1-1-3\" data-name=\"mobile menu toggle button\">\n            <i class=\"ti ti-menu-2\" data-kid=\"1-1-3-1\" data-name=\"menu hamburger icon\">\n            </i>\n        </div>\n    </header>\n    <main class=\"flex-1 grid lg:grid-cols-[1.02fr_.98fr] min-h-0\" data-kid=\"1-2\" data-name=\"main content grid\">\n        <section class=\"relative overflow-hidden px-7 py-10 sm:px-12 lg:px-16 lg:py-16 flex flex-col justify-between border-b-[3px] lg:border-b-0 lg:border-r-[3px] border-[#121210]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"absolute right-8 top-8 w-24 h-24 border-[3px] border-[#121210] rounded-full opacity-20\" data-kid=\"1-2-1-1\" data-name=\"decorative circle outline\">\n            </div>\n            <div class=\"absolute right-[70px] top-[70px] w-5 h-5 bg-[#E8A030] border-2 border-[#121210]\" data-kid=\"1-2-1-2\" data-name=\"decorative accent square\">\n            </div>\n            <div class=\"relative max-w-[590px]\" data-kid=\"1-2-1-3\" data-name=\"hero content block\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-2 border-2 border-[#121210] bg-white font-mono text-[10px] tracking-[.13em] uppercase\" data-kid=\"1-2-1-3-1\" data-name=\"location badge label\">\n                    <span class=\"w-2.5 h-2.5 bg-[#2E8C42] border border-[#121210]\" data-kid=\"1-2-1-3-1-1\" data-name=\"badge indicator dot\">\n                    </span>\n                    Public service · Jharkhand\n                </div>\n                <p class=\"font-mono text-[11px] tracking-[.18em] mt-12 opacity-65\" data-kid=\"1-2-1-3-2\" data-name=\"hero eyebrow text\">\n                    YOUR CITY. YOUR VOICE.\n                </p>\n                <h1 class=\"font-display font-extrabold text-[clamp(3rem,5vw,5rem)] leading-[.91] mt-4\" data-kid=\"1-2-1-3-3\" data-name=\"hero headline text\">\n                    A better\n                    <br data-kid=\"1-2-1-3-3-1\" data-name=\"line break\"/>\n                    neighbourhood\n                    <br data-kid=\"1-2-1-3-3-2\" data-name=\"line break\"/>\n                    <span class=\"text-[#2E8C42]\" data-kid=\"1-2-1-3-3-3\" data-name=\"headline accent phrase\">\n                        starts here.\n                    </span>\n                </h1>\n                <p class=\"text-lg sm:text-xl leading-relaxed max-w-[500px] mt-7\" data-kid=\"1-2-1-3-4\" data-name=\"hero description text\">\n                    Welcome back. Sign in to report a local issue, follow its progress, and help your community move forward.\n                </p>\n            </div>\n            <div class=\"relative mt-12 lg:mt-8\" data-kid=\"1-2-1-4\" data-name=\"community stats block\">\n                <div class=\"font-mono text-[10px] tracking-[.18em] opacity-60 mb-3\" data-kid=\"1-2-1-4-1\" data-name=\"stats section label\">\n                    COMMUNITY AT A GLANCE\n                </div>\n                <div class=\"grid grid-cols-2 gap-3 max-w-[520px]\" data-kid=\"1-2-1-4-2\" data-name=\"stats grid container\">\n                    <div class=\"outline-card bg-white p-4 sm:p-5\" data-kid=\"1-2-1-4-2-1\" data-name=\"reports received stat card\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-1-4-2-1-1\" data-name=\"stat card header row\">\n                            <span class=\"font-mono text-[9px] tracking-[.1em] opacity-60\" data-kid=\"1-2-1-4-2-1-1-1\" data-name=\"stat label text\">\n                                REPORTS RECEIVED\n                            </span>\n                            <i class=\"ti ti-file-report text-xl text-[#2E8C42]\" data-kid=\"1-2-1-4-2-1-1-2\" data-name=\"document report icon\">\n                            </i>\n                        </div>\n                        <div class=\"font-display font-extrabold text-3xl sm:text-4xl mt-3\" data-kid=\"1-2-1-4-2-1-2\" data-name=\"stat number value\">\n                            2,481\n                        </div>\n                        <div class=\"text-xs mt-1 opacity-65\" data-kid=\"1-2-1-4-2-1-3\" data-name=\"stat caption text\">\n                            from residents like you\n                        </div>\n                    </div>\n                    <div class=\"outline-card bg-[#2E8C42] text-white p-4 sm:p-5\" data-kid=\"1-2-1-4-2-2\" data-name=\"issues resolved stat card\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-1-4-2-2-1\" data-name=\"stat card header row\">\n                            <span class=\"font-mono text-[9px] tracking-[.1em]\" data-kid=\"1-2-1-4-2-2-1-1\" data-name=\"stat label text\">\n                                ISSUES RESOLVED\n                            </span>\n                            <i class=\"ti ti-circle-check text-xl\" data-kid=\"1-2-1-4-2-2-1-2\" data-name=\"checkmark circle icon\">\n                            </i>\n                        </div>\n                        <div class=\"font-display font-extrabold text-3xl sm:text-4xl mt-3\" data-kid=\"1-2-1-4-2-2-2\" data-name=\"stat number value\">\n                            1,936\n                        </div>\n                        <div class=\"text-xs mt-1 text-white/80\" data-kid=\"1-2-1-4-2-2-3\" data-name=\"stat caption text\">\n                            making neighbourhoods better\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3 mt-7 text-xs sm:text-sm\" data-kid=\"1-2-1-4-3\" data-name=\"trust note row\">\n                    <span class=\"w-9 h-9 border-2 border-[#121210] bg-[#E8A030] flex items-center justify-center text-lg\" data-kid=\"1-2-1-4-3-1\" data-name=\"shield icon badge\">\n                        <i class=\"ti ti-shield-check\" data-kid=\"1-2-1-4-3-1-1\" data-name=\"shield check icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-4-3-2\" data-name=\"trust note text\">\n                        <b data-kid=\"1-2-1-4-3-2-1\" data-name=\"trust note bold phrase\">\n                            Built around public trust.\n                        </b>\n                        Follow every update, from report to resolution.\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"paper-grid px-5 py-10 sm:px-10 lg:px-14 lg:py-14 flex items-center justify-center\" data-kid=\"1-2-2\" data-name=\"login section with paper grid background\">\n            <div class=\"outline-card bg-white w-full max-w-[530px] p-6 sm:p-10 lg:p-11\" data-kid=\"1-2-2-1\" data-name=\"login card container\">\n                <div class=\"flex items-center justify-between gap-3 mb-8\" data-kid=\"1-2-2-1-1\" data-name=\"login card header row\">\n                    <span class=\"font-mono text-[10px] tracking-[.16em] opacity-60\" data-kid=\"1-2-2-1-1-1\" data-name=\"login section label\">\n                        CITIZEN ACCESS / 01\n                    </span>\n                    <span class=\"tag inline-flex items-center gap-2 border-2 border-[#121210] bg-[#CFE8D6] px-3 py-1.5 font-mono text-[9px] tracking-[.1em]\" data-kid=\"1-2-2-1-1-2\" data-name=\"secure sign-in badge\">\n                        <span class=\"w-2 h-2 bg-[#2E8C42] rounded-full\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"badge indicator dot\">\n                        </span>\n                        SECURE SIGN IN\n                    </span>\n                </div>\n                <h2 class=\"font-display font-extrabold text-4xl sm:text-5xl leading-none\" data-kid=\"1-2-2-1-2\" data-name=\"login card heading\">\n                    User Login\n                </h2>\n                <p class=\"mt-3 text-[15px] opacity-70\" data-kid=\"1-2-2-1-3\" data-name=\"login card subheading\">\n                    Good to see you again. Enter your account details.\n                </p>\n                <form aria-label=\"User login form\" class=\"mt-8 space-y-5\" data-kid=\"1-2-2-1-4\" data-name=\"login form\">\n                    <div data-kid=\"1-2-2-1-4-1\" data-name=\"username field group\">\n                        <label class=\"block font-display font-bold text-sm mb-2\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"username label\" for=\"username\">\n                            Username\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-2-2-1-4-1-2\" data-name=\"username input wrapper\">\n                            <i class=\"ti ti-user absolute left-4 top-1/2 -translate-y-1/2 text-xl opacity-55\" data-kid=\"1-2-2-1-4-1-2-1\" data-name=\"user icon\">\n                            </i>\n                            <input autocomplete=\"username\" class=\"w-full min-h-[54px] border-[2px] border-[#121210] bg-white pl-12 pr-4 text-[15px] placeholder:text-[#121210]/40 focus:outline-none focus:ring-4 focus:ring-[#2E8C42]/30 focus:border-[#2E8C42]\" data-kid=\"1-2-2-1-4-1-2-2\" data-name=\"username input field\" id=\"username\" placeholder=\"Enter your username\" type=\"text\"/>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-2-1-4-2\" data-name=\"password field group\">\n                        <label class=\"block font-display font-bold text-sm mb-2\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"password label\" for=\"password\">\n                            Password\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-2-2-1-4-2-2\" data-name=\"password input wrapper\">\n                            <i class=\"ti ti-lock absolute left-4 top-1/2 -translate-y-1/2 text-xl opacity-55\" data-kid=\"1-2-2-1-4-2-2-1\" data-name=\"lock icon\">\n                            </i>\n                            <input autocomplete=\"current-password\" class=\"w-full min-h-[54px] border-[2px] border-[#121210] bg-white pl-12 pr-4 text-[15px] placeholder:text-[#121210]/40 focus:outline-none focus:ring-4 focus:ring-[#2E8C42]/30 focus:border-[#2E8C42]\" data-kid=\"1-2-2-1-4-2-2-2\" data-name=\"password input field\" id=\"password\" placeholder=\"Enter your password\" type=\"password\"/>\n                        </div>\n                    </div>\n                    <div class=\"border-2 border-[#C03A3A] bg-[#C03A3A]/[.08] px-3 py-2.5 flex items-start gap-2.5 text-[#8F2727]\" data-kid=\"1-2-2-1-4-3\" data-name=\"login error alert\" role=\"status\">\n                        <i class=\"ti ti-alert-circle text-lg mt-0.5\" data-kid=\"1-2-2-1-4-3-1\" data-name=\"alert circle icon\">\n                        </i>\n                        <div data-kid=\"1-2-2-1-4-3-2\" data-name=\"alert message container\">\n                            <div class=\"font-display font-bold text-sm\" data-kid=\"1-2-2-1-4-3-2-1\" data-name=\"alert title text\">\n                                We couldn't sign you in\n                            </div>\n                            <div class=\"text-xs mt-0.5\" data-kid=\"1-2-2-1-4-3-2-2\" data-name=\"alert description text\">\n                                Check your username and password, then try again.\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"w-full min-h-[56px] border-[3px] border-[#121210] bg-[#2E8C42] text-white shadow-[4px_4px_0_#121210] hover:bg-[#267738] active:translate-x-1 active:translate-y-1 active:shadow-none focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-[#2E8C42] font-display font-bold text-lg flex items-center justify-center gap-3\" data-kid=\"1-2-2-1-4-4\" data-name=\"primary log-in button\" type=\"button\">\n                        <i class=\"ti ti-login-2 text-xl\" data-kid=\"1-2-2-1-4-4-1\" data-name=\"log-in icon\">\n                        </i>\n                        Log In\n                    </button>\n                </form>\n                <div class=\"mt-7 pt-6 border-t-[2px] border-[#121210]/20 text-center\" data-kid=\"1-2-2-1-5\" data-name=\"create account footer block\">\n                    <p class=\"text-sm\" data-kid=\"1-2-2-1-5-1\" data-name=\"create account prompt text\">\n                        Don't have an account?\n                        <a class=\"font-display font-bold text-[#2E8C42] underline decoration-2 underline-offset-4 hover:text-[#121210] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2E8C42]\" data-kid=\"1-2-2-1-5-1-1\" data-name=\"create account link\" href=\"#\">\n                            Create an account\n                        </a>\n                    </p>\n                </div>\n                <div class=\"mt-7 flex items-center gap-2 justify-center font-mono text-[9px] tracking-[.1em] opacity-55\" data-kid=\"1-2-2-1-6\" data-name=\"security notice row\">\n                    <i class=\"ti ti-lock-check text-base\" data-kid=\"1-2-2-1-6-1\" data-name=\"lock check icon\">\n                    </i>\n                    YOUR ACCOUNT DETAILS ARE PROTECTED\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t-[3px] border-[#121210] bg-[#CFE8D6] px-6 sm:px-10 py-4 flex flex-col sm:flex-row gap-2 justify-between items-center text-[11px]\" data-kid=\"1-3\" data-name=\"footer bar\">\n        <span class=\"font-display font-semibold\" data-kid=\"1-3-1\" data-name=\"footer brand text\">\n            NagarSeva\n            <span class=\"font-mono font-normal opacity-60\" data-kid=\"1-3-1-1\" data-name=\"footer brand tagline\">\n                · COMMUNITY ISSUE PORTAL\n            </span>\n        </span>\n        <span class=\"font-mono text-[9px] tracking-[.1em] opacity-55\" data-kid=\"1-3-2\" data-name=\"footer motto text\">\n            REPORT · TRACK · RESOLVE\n        </span>\n    </footer>\n</div>\n",

      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\nbody{font-family:'Hanken Grotesk',sans-serif;background:#CFE8D6;color:#121210}.display{font-family:'Archivo',sans-serif;letter-spacing:-.025em}.mono{font-family:'Space Mono',monospace;font-variant-numeric:tabular-nums}.panel{border:3px solid #121210;box-shadow:5px 5px 0 #121210}.lift{border:3px solid #121210;box-shadow:4px 4px 0 #121210}.grid-paper{background-image:linear-gradient(rgba(18,18,16,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(18,18,16,.075) 1px,transparent 1px);background-size:24px 24px}.tag{display:inline-flex;align-items:center;gap:6px;border:2px solid #121210;padding:4px 9px;font-size:10px;line-height:1.2;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.nav-link{border:2px solid #121210;box-shadow:3px 3px 0 #121210}.btn{border:3px solid #121210;box-shadow:4px 4px 0 #121210}.step-card{border:3px solid #121210;box-shadow:4px 4px 0 #121210}\n@media(max-width:900px){.layout{display:block!important}.rail{width:100%!important;min-height:auto!important;border-right:0!important;border-bottom:3px solid #121210}.rail-links{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))}.rail-foot{display:none!important}.main-pad{padding:20px!important}.top-tools{display:none!important}.hero-grid{grid-template-columns:1fr!important}.steps{grid-template-columns:1fr!important}.recent-grid{grid-template-columns:1fr!important}.impact{grid-template-columns:1fr 1fr!important}}\n@media(max-width:560px){.rail-links{grid-template-columns:1fr 1fr}.impact{grid-template-columns:1fr 1fr!important}.hero-title{font-size:48px!important}.hero-panel{padding:24px!important}.hide-small{display:none!important}}\n</style>\n<div class=\"layout min-h-screen flex\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside class=\"rail w-[248px] shrink-0 min-h-screen bg-[#CFE8D6] border-r-[3px] border-[#121210] p-5 flex flex-col\" data-kid=\"1-1\" data-name=\"sidellite navigation rail\">\n        <div class=\"flex items-center gap-3 mb-9\" data-kid=\"1-1-1\" data-name=\"logo lockup header\">\n            <div class=\"w-11 h-11 bg-[#2E8C42] panel flex items-center justify-center text-white text-2xl\" data-kid=\"1-1-1-1\" data-name=\"brand logo tile\">\n                <i class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1\" data-name=\"building community icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n                <div class=\"display text-xl font-extrabold leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"brand name title\">\n                    NAGARSEVA\n                </div>\n                <div class=\"mono text-[9px] tracking-[.17em] opacity-60 mt-1\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle tagline\">\n                    CITIZEN DESK · JH\n                </div>\n            </div>\n        </div>\n        <div class=\"mono text-[10px] tracking-[.16em] opacity-50 mb-3 px-1\" data-kid=\"1-1-2\" data-name=\"section label community\">\n            COMMUNITY\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"rail-links flex flex-col gap-3\" data-kid=\"1-1-3\" data-name=\"main navigation links\">\n            <a class=\"nav-link bg-[#121210] text-white flex items-center gap-3 px-3 py-3 font-semibold\" data-kid=\"1-1-3-1\" data-name=\"home navigation link\" href=\"#home\">\n                <i class=\"ti ti-home text-xl\" data-kid=\"1-1-3-1-1\" data-name=\"home icon\">\n                </i>\n                Home\n                <span class=\"mono text-[9px] ml-auto opacity-70\" data-kid=\"1-1-3-1-2\" data-name=\"nav item number\">\n                    01\n                </span>\n            </a>\n            <a class=\"nav-link bg-white flex items-center justify-between px-3 py-3 font-semibold\" data-kid=\"1-1-3-2\" data-name=\"issue list navigation link\" href=\"#issues\">\n                <span class=\"flex items-center gap-3\" data-kid=\"1-1-3-2-1\" data-name=\"issue list label with icon\">\n                    <i class=\"ti ti-list-check text-xl\" data-kid=\"1-1-3-2-1-1\" data-name=\"checklist icon\">\n                    </i>\n                    Issue List\n                </span>\n                <span class=\"mono text-xs bg-[#121210] text-white px-2 py-0.5\" data-kid=\"1-1-3-2-2\" data-name=\"issue count badge\">\n                    24\n                </span>\n            </a>\n            <a class=\"nav-link bg-white flex items-center gap-3 px-3 py-3 font-semibold\" data-kid=\"1-1-3-3\" data-name=\"report an issue navigation link\" href=\"#report\">\n                <i class=\"ti ti-camera-plus text-xl\" data-kid=\"1-1-3-3-1\" data-name=\"camera plus icon\">\n                </i>\n                Report an Issue\n            </a>\n            <a class=\"nav-link bg-white flex items-center gap-3 px-3 py-3 font-semibold\" data-kid=\"1-1-3-4\" data-name=\"log in navigation link\" href=\"#login\">\n                <i class=\"ti ti-user text-xl\" data-kid=\"1-1-3-4-1\" data-name=\"user icon\">\n                </i>\n                Log In\n            </a>\n        </nav>\n        <div class=\"rail-foot mt-auto\" data-kid=\"1-1-4\" data-name=\"sidellite footer block\">\n            <div class=\"panel bg-white p-4\" data-kid=\"1-1-4-1\" data-name=\"community pulse stat card\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-1-4-1-1\" data-name=\"stat card header row\">\n                    <span class=\"mono text-[9px] tracking-[.12em] opacity-60\" data-kid=\"1-1-4-1-1-1\" data-name=\"stat card label\">\n                        COMMUNITY PULSE\n                    </span>\n                    <span class=\"w-2.5 h-2.5 rounded-full bg-[#2E8C42] border border-[#121210]\" data-kid=\"1-1-4-1-1-2\" data-name=\"live status dot\">\n                    </span>\n                </div>\n                <div class=\"display font-extrabold text-[38px] leading-none mt-3\" data-kid=\"1-1-4-1-2\" data-name=\"resolved percentage figure\">\n                    68\n                    <span class=\"text-lg\" data-kid=\"1-1-4-1-2-1\" data-name=\"percent sign\">\n                        %\n                    </span>\n                </div>\n                <div class=\"text-xs mt-1\" data-kid=\"1-1-4-1-3\" data-name=\"stat card description\">\n                    of reported issues resolved\n                </div>\n                <div class=\"h-3 border-2 border-[#121210] mt-3 flex\" data-kid=\"1-1-4-1-4\" data-name=\"progress segmented bar\">\n                    <div class=\"bg-[#2E8C42] w-[68%]\" data-kid=\"1-1-4-1-4-1\" data-name=\"resolved segment\">\n                    </div>\n                    <div class=\"bg-[#E8A030] w-[17%]\" data-kid=\"1-1-4-1-4-2\" data-name=\"in-progress segment\">\n                    </div>\n                    <div class=\"bg-white flex-1\" data-kid=\"1-1-4-1-4-3\" data-name=\"unresolved segment\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"mono text-[9px] leading-5 opacity-50 mt-5 px-1\" data-kid=\"1-1-4-2\" data-name=\"community tagline text\">\n                A SHARED SPACE FOR\n                <br data-kid=\"1-1-4-2-1\" data-name=\"tagline line break\"/>\n                BETTER NEIGHBOURHOODS\n            </div>\n        </div>\n    </aside>\n    <main class=\"flex-1 min-w-0\" data-kid=\"1-2\" data-name=\"main content area\" id=\"home\">\n        <header class=\"border-b-[3px] border-[#121210] px-8 py-5 flex items-center justify-between gap-5\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n            <div data-kid=\"1-2-1-1\" data-name=\"header brand info\">\n                <div class=\"mono text-[10px] tracking-[.13em] opacity-55\" data-kid=\"1-2-1-1-1\" data-name=\"header region label\">\n                    JHARKHAND · CITIZEN SERVICES\n                </div>\n                <h1 class=\"display text-[27px] font-bold leading-tight mt-1\" data-kid=\"1-2-1-1-2\" data-name=\"header headline\">\n                    Your neighbourhood, heard.\n                </h1>\n            </div>\n            <div class=\"top-tools flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"header tools\">\n                <div class=\"lift bg-white flex items-center gap-2 px-3 py-2 w-[240px] text-sm\" data-kid=\"1-2-1-2-1\" data-name=\"search input field\">\n                    <i class=\"ti ti-search text-lg\" data-kid=\"1-2-1-2-1-1\" data-name=\"search icon\">\n                    </i>\n                    <span class=\"opacity-50\" data-kid=\"1-2-1-2-1-2\" data-name=\"search placeholder text\">\n                        Search issues…\n                    </span>\n                    <span class=\"mono text-[9px] border border-[#121210] px-1 ml-auto\" data-kid=\"1-2-1-2-1-3\" data-name=\"keyboard shortcut hint\">\n                        ⌘K\n                    </span>\n                </div>\n                <a class=\"btn bg-[#121210] text-white px-4 py-2.5 display text-sm font-bold\" data-kid=\"1-2-1-2-2\" data-name=\"log in call-to-action button\" href=\"#login\">\n                    LOG IN\n                    <i class=\"ti ti-arrow-up-right ml-2\" data-kid=\"1-2-1-2-2-1\" data-name=\"arrow up-right icon\">\n                    </i>\n                </a>\n            </div>\n        </header>\n        <div class=\"main-pad p-8 max-w-[1320px] mx-auto\" data-kid=\"1-2-2\" data-name=\"main content padding container\">\n            <section class=\"hero-grid grid grid-cols-[1.15fr_.85fr] gap-7 items-stretch\" data-kid=\"1-2-2-1\" data-name=\"hero section\">\n                <div class=\"hero-panel panel bg-white p-9 relative overflow-hidden\" data-kid=\"1-2-2-1-1\" data-name=\"hero primary panel\">\n                    <div class=\"flex items-center gap-2 mb-6\" data-kid=\"1-2-2-1-1-1\" data-name=\"hero tag row\">\n                        <span class=\"tag bg-[#CFE8D6]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"hero location tag\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            LOCAL VOICES. REAL CHANGE.\n                        </span>\n                        <span class=\"mono text-[9px] opacity-50\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"hero section number\">\n                            01 / WELCOME\n                        </span>\n                    </div>\n                    <h2 class=\"hero-title display text-[66px] leading-[.98] font-black max-w-[640px]\" data-kid=\"1-2-2-1-1-2\" data-name=\"hero headline text\">\n                        Report.\n                        <br data-kid=\"1-2-2-1-1-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-[#2E8C42]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"highlighted word track\">\n                            Track.\n                        </span>\n                        <br data-kid=\"1-2-2-1-1-2-3\" data-name=\"headline line break\"/>\n                        Resolve.\n                    </h2>\n                    <p class=\"text-[17px] leading-7 max-w-[510px] mt-6 text-[#30312e]\" data-kid=\"1-2-2-1-1-3\" data-name=\"hero description text\">\n                        Your voice for a better Jharkhand. Tell us what needs attention in your neighbourhood, follow its progress, and help make everyday places better for everyone.\n                    </p>\n                    <div class=\"flex flex-wrap items-center gap-4 mt-7\" data-kid=\"1-2-2-1-1-4\" data-name=\"hero action buttons row\">\n                        <a class=\"btn bg-[#2E8C42] text-white px-6 py-4 display font-bold text-base inline-flex items-center gap-3\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"report issue primary button\" href=\"#report\">\n                            Report an Issue Now\n                            <i class=\"ti ti-arrow-right text-xl\" data-kid=\"1-2-2-1-1-4-1-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                        <a class=\"font-semibold inline-flex items-center gap-2 underline underline-offset-4\" data-kid=\"1-2-2-1-1-4-2\" data-name=\"explore issues text link\" href=\"#issues\">\n                            Explore community issues\n                            <i class=\"ti ti-arrow-down-right\" data-kid=\"1-2-2-1-1-4-2-1\" data-name=\"arrow down-right icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"mono text-[9px] tracking-[.12em] opacity-50 mt-7\" data-kid=\"1-2-2-1-1-5\" data-name=\"hero micro caption\">\n                        A SIMPLE WAY TO MAKE YOUR CONCERN COUNT\n                    </div>\n                    <div class=\"absolute -right-5 -bottom-8 text-[#CFE8D6] text-[145px] opacity-50 pointer-events-none\" data-kid=\"1-2-2-1-1-6\" data-name=\"decorative background icon wrapper\">\n                        <i class=\"ti ti-building-community\" data-kid=\"1-2-2-1-1-6-1\" data-name=\"building community icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"grid-paper panel p-6 flex flex-col justify-between min-h-[390px]\" data-kid=\"1-2-2-1-2\" data-name=\"community snapshot panel\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-1-2-1\" data-name=\"panel header row\">\n                        <span class=\"mono text-[10px] tracking-[.14em]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"panel section label\">\n                            COMMUNITY SNAPSHOT\n                        </span>\n                        <span class=\"tag bg-white\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"live feed tag\">\n                            LIVE FEED\n                        </span>\n                    </div>\n                    <div data-kid=\"1-2-2-1-2-2\" data-name=\"reports stats block\">\n                        <div class=\"mono text-[10px] opacity-55 tracking-[.12em]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"stats sublabel\">\n                            REPORTS SHARED BY RESIDENTS\n                        </div>\n                        <div class=\"display text-[76px] font-black leading-none mt-2\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"reports total figure\">\n                            1,284\n                            <span class=\"text-[#2E8C42]\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"increment plus sign\">\n                                +\n                            </span>\n                        </div>\n                        <div class=\"h-[3px] bg-[#121210] w-full mt-5\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"stats divider line\">\n                        </div>\n                        <div class=\"impact grid grid-cols-2 gap-3 mt-4\" data-kid=\"1-2-2-1-2-2-4\" data-name=\"stat impact grid\">\n                            <div class=\"bg-white border-2 border-[#121210] p-3\" data-kid=\"1-2-2-1-2-2-4-1\" data-name=\"resolved stat card\">\n                                <div class=\"mono text-[9px] opacity-55\" data-kid=\"1-2-2-1-2-2-4-1-1\" data-name=\"stat label\">\n                                    RESOLVED\n                                </div>\n                                <div class=\"display font-bold text-2xl mt-1\" data-kid=\"1-2-2-1-2-2-4-1-2\" data-name=\"resolved count value\">\n                                    872\n                                </div>\n                                <div class=\"text-xs text-[#2E8C42] font-semibold\" data-kid=\"1-2-2-1-2-2-4-1-3\" data-name=\"resolved percentage note\">\n                                    68% of reports\n                                </div>\n                            </div>\n                            <div class=\"bg-[#E8A030] border-2 border-[#121210] p-3\" data-kid=\"1-2-2-1-2-2-4-2\" data-name=\"in-progress stat card\">\n                                <div class=\"mono text-[9px]\" data-kid=\"1-2-2-1-2-2-4-2-1\" data-name=\"stat label\">\n                                    IN PROGRESS\n                                </div>\n                                <div class=\"display font-bold text-2xl mt-1\" data-kid=\"1-2-2-1-2-2-4-2-2\" data-name=\"in-progress count value\">\n                                    219\n                                </div>\n                                <div class=\"text-xs font-semibold\" data-kid=\"1-2-2-1-2-2-4-2-3\" data-name=\"in-progress note\">\n                                    Being addressed\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between mt-5\" data-kid=\"1-2-2-1-2-3\" data-name=\"community footer row\">\n                        <span class=\"mono text-[9px] opacity-55\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"community call-to-action text\">\n                            EVERY REPORT MOVES US FORWARD\n                        </span>\n                        <span class=\"flex -space-x-2\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"resident avatars stack\">\n                            <span class=\"w-8 h-8 rounded-full bg-[#2E8C42] border-2 border-[#121210] text-white flex items-center justify-center text-xs font-bold\" data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"resident avatar R\">\n                                R\n                            </span>\n                            <span class=\"w-8 h-8 rounded-full bg-[#E8A030] border-2 border-[#121210] flex items-center justify-center text-xs font-bold\" data-kid=\"1-2-2-1-2-3-2-2\" data-name=\"resident avatar S\">\n                                S\n                            </span>\n                            <span class=\"w-8 h-8 rounded-full bg-[#C03A3A] border-2 border-[#121210] text-white flex items-center justify-center text-xs font-bold\" data-kid=\"1-2-2-1-2-3-2-3\" data-name=\"resident avatar more flag\">\n                                +\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"how-heading\" class=\"mt-8\" data-kid=\"1-2-2-2\" data-name=\"how it works section\">\n                <div class=\"flex items-end justify-between mb-4\" data-kid=\"1-2-2-2-1\" data-name=\"section header row\">\n                    <div data-kid=\"1-2-2-2-1-1\" data-name=\"section header text block\">\n                        <div class=\"mono text-[9px] tracking-[.14em] opacity-55\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"section eyebrow text\">\n                            THREE STEPS · ONE BETTER COMMUNITY\n                        </div>\n                        <h3 class=\"display font-bold text-[27px] mt-1\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"section heading\" id=\"how-heading\">\n                            From concern to change.\n                        </h3>\n                    </div>\n                    <span class=\"tag bg-white hide-small\" data-kid=\"1-2-2-2-1-2\" data-name=\"how it works tag\">\n                        HOW IT WORKS\n                    </span>\n                </div>\n                <div class=\"steps grid grid-cols-3 gap-4\" data-kid=\"1-2-2-2-2\" data-name=\"steps grid\">\n                    <article class=\"step-card bg-[#2E8C42] text-white p-5\" data-kid=\"1-2-2-2-2-1\" data-name=\"step 1 card\">\n                        <div class=\"flex justify-between items-start\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"step 1 header row\">\n                            <span class=\"mono text-[10px] opacity-75\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"step number label\">\n                                STEP 01\n                            </span>\n                            <i class=\"ti ti-camera text-3xl\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"camera icon\">\n                            </i>\n                        </div>\n                        <h4 class=\"display font-bold text-xl mt-5\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"step 1 title\">\n                            Snap & Describe\n                        </h4>\n                        <p class=\"text-sm leading-5 mt-2 opacity-90\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"step 1 description\">\n                            Take a photo and tell us what is happening where you live.\n                        </p>\n                    </article>\n                    <article class=\"step-card bg-white p-5\" data-kid=\"1-2-2-2-2-2\" data-name=\"step 2 card\">\n                        <div class=\"flex justify-between items-start\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"step 2 header row\">\n                            <span class=\"mono text-[10px] opacity-55\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"step number label\">\n                                STEP 02\n                            </span>\n                            <i class=\"ti ti-send text-3xl\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"send icon\">\n                            </i>\n                        </div>\n                        <h4 class=\"display font-bold text-xl mt-5\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"step 2 title\">\n                            Submit Your Report\n                        </h4>\n                        <p class=\"text-sm leading-5 mt-2 opacity-75\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"step 2 description\">\n                            Add the location and category, then send your report to the community issue feed.\n                        </p>\n                    </article>\n                    <article class=\"step-card bg-[#E8A030] p-5\" data-kid=\"1-2-2-2-2-3\" data-name=\"step 3 card\">\n                        <div class=\"flex justify-between items-start\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"step 3 header row\">\n                            <span class=\"mono text-[10px] opacity-65\" data-kid=\"1-2-2-2-2-3-1-1\" data-name=\"step number label\">\n                                STEP 03\n                            </span>\n                            <i class=\"ti ti-circle-check text-3xl\" data-kid=\"1-2-2-2-2-3-1-2\" data-name=\"circle check icon\">\n                            </i>\n                        </div>\n                        <h4 class=\"display font-bold text-xl mt-5\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"step 3 title\">\n                            See It Resolved\n                        </h4>\n                        <p class=\"text-sm leading-5 mt-2\" data-kid=\"1-2-2-2-2-3-3\" data-name=\"step 3 description\">\n                            Track updates and see the community’s reported issues move forward.\n                        </p>\n                    </article>\n                </div>\n            </section>\n            <section class=\"mt-8 panel bg-white overflow-hidden\" data-kid=\"1-2-2-3\" data-name=\"recent issues section\" id=\"issues\">\n                <div class=\"flex items-center justify-between gap-4 px-5 py-4 border-b-[3px] border-[#121210]\" data-kid=\"1-2-2-3-1\" data-name=\"section header\">\n                    <div data-kid=\"1-2-2-3-1-1\" data-name=\"section header text block\">\n                        <div class=\"mono text-[9px] tracking-[.13em] opacity-55\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"section eyebrow label\">\n                            FROM YOUR COMMUNITY\n                        </div>\n                        <h3 class=\"display text-xl font-bold mt-1\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"section heading\">\n                            Recent issues\n                        </h3>\n                    </div>\n                    <a class=\"font-semibold text-sm underline underline-offset-4\" data-kid=\"1-2-2-3-1-2\" data-name=\"view all issues link\" href=\"#issues\">\n                        View all issues\n                        <i class=\"ti ti-arrow-right\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"recent-grid grid grid-cols-3 divide-x-[2px] divide-[#121210]\" data-kid=\"1-2-2-3-2\" data-name=\"recent issues grid\">\n                    <article class=\"p-5\" data-kid=\"1-2-2-3-2-1\" data-name=\"issue card pothole\">\n                        <div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"issue card meta row\">\n                            <span class=\"tag bg-[#CFE8D6]\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"issue category tag\">\n                                ROAD & STREET\n                            </span>\n                            <span class=\"mono text-[9px] opacity-55\" data-kid=\"1-2-2-3-2-1-1-2\" data-name=\"issue date\">\n                                12 JUN\n                            </span>\n                        </div>\n                        <h4 class=\"display font-bold text-lg mt-4\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"issue card title\">\n                            Pothole near Main Market road\n                        </h4>\n                        <div class=\"text-sm opacity-65 mt-1 flex items-center gap-1\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"issue location line\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-3-2-1-3-1\" data-name=\"map pin icon\">\n                            </i>\n                            Ranchi · Ward 12\n                        </div>\n                        <div class=\"flex items-center justify-between mt-5\" data-kid=\"1-2-2-3-2-1-4\" data-name=\"issue status row\">\n                            <span class=\"tag bg-[#E8A030]\" data-kid=\"1-2-2-3-2-1-4-1\" data-name=\"status tag in progress\">\n                                IN PROGRESS\n                            </span>\n                            <span class=\"mono text-[10px] opacity-60\" data-kid=\"1-2-2-3-2-1-4-2\" data-name=\"endorsement count\">\n                                <i class=\"ti ti-thumb-up\" data-kid=\"1-2-2-3-2-1-4-2-1\" data-name=\"thumb up icon\">\n                                </i>\n                                18\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"p-5\" data-kid=\"1-2-2-3-2-2\" data-name=\"issue card water leak\">\n                        <div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"issue card meta row\">\n                            <span class=\"tag bg-[#CFE8D6]\" data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"issue category tag\">\n                                WATER\n                            </span>\n                            <span class=\"mono text-[9px] opacity-55\" data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"issue date\">\n                                11 JUN\n                            </span>\n                        </div>\n                        <h4 class=\"display font-bold text-lg mt-4\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"issue card title\">\n                            Public tap leaking on Station Road\n                        </h4>\n                        <div class=\"text-sm opacity-65 mt-1 flex items-center gap-1\" data-kid=\"1-2-2-3-2-2-3\" data-name=\"issue location line\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-3-2-2-3-1\" data-name=\"map pin icon\">\n                            </i>\n                            Jamshedpur · Ward 4\n                        </div>\n                        <div class=\"flex items-center justify-between mt-5\" data-kid=\"1-2-2-3-2-2-4\" data-name=\"issue status row\">\n                            <span class=\"tag bg-[#C03A3A] text-white\" data-kid=\"1-2-2-3-2-2-4-1\" data-name=\"status tag open\">\n                                OPEN\n                            </span>\n                            <span class=\"mono text-[10px] opacity-60\" data-kid=\"1-2-2-3-2-2-4-2\" data-name=\"endorsement count\">\n                                <i class=\"ti ti-thumb-up\" data-kid=\"1-2-2-3-2-2-4-2-1\" data-name=\"thumb up icon\">\n                                </i>\n                                9\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"p-5\" data-kid=\"1-2-2-3-2-3\" data-name=\"issue card cleanliness\">\n                        <div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"issue card meta row\">\n                            <span class=\"tag bg-[#CFE8D6]\" data-kid=\"1-2-2-3-2-3-1-1\" data-name=\"issue category tag\">\n                                CLEANLINESS\n                            </span>\n                            <span class=\"mono text-[9px] opacity-55\" data-kid=\"1-2-2-3-2-3-1-2\" data-name=\"issue date\">\n                                10 JUN\n                            </span>\n                        </div>\n                        <h4 class=\"display font-bold text-lg mt-4\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"issue card title\">\n                            Waste collection missed this week\n                        </h4>\n                        <div class=\"text-sm opacity-65 mt-1 flex items-center gap-1\" data-kid=\"1-2-2-3-2-3-3\" data-name=\"issue location line\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-3-2-3-3-1\" data-name=\"map pin icon\">\n                            </i>\n                            Dhanbad · Ward 8\n                        </div>\n                        <div class=\"flex items-center justify-between mt-5\" data-kid=\"1-2-2-3-2-3-4\" data-name=\"issue status row\">\n                            <span class=\"tag bg-[#2E8C42] text-white\" data-kid=\"1-2-2-3-2-3-4-1\" data-name=\"status tag resolved\">\n                                RESOLVED\n                            </span>\n                            <span class=\"mono text-[10px] opacity-60\" data-kid=\"1-2-2-3-2-3-4-2\" data-name=\"endorsement count\">\n                                <i class=\"ti ti-thumb-up\" data-kid=\"1-2-2-3-2-3-4-2-1\" data-name=\"thumb up icon\">\n                                </i>\n                                24\n                            </span>\n                        </div>\n                    </article>\n                </div>\n            </section>\n            <footer class=\"flex flex-wrap items-center justify-between gap-2 py-5 mono text-[9px] opacity-55\" data-kid=\"1-2-2-4\" data-name=\"main footer bar\">\n                <span data-kid=\"1-2-2-4-1\" data-name=\"footer brand text\">\n                    NAGARSEVA · CITIZEN ISSUE REPORTING\n                </span>\n                <span data-kid=\"1-2-2-4-2\" data-name=\"footer tagline\">\n                    REPORT WHAT MATTERS IN YOUR COMMUNITY\n                </span>\n            </footer>\n        </div>\n    </main>\n</div>\n",
      "comments": [],

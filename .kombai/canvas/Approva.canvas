      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\nbody{font-family:'Hanken Grotesk',sans-serif;background:#CFE8D6;color:#121210}.display{font-family:'Archivo',sans-serif;letter-spacing:-.02em}.mono{font-family:'Space Mono',monospace;font-variant-numeric:tabular-nums}.frame{border:3px solid #121210;box-shadow:4px 4px 0 #121210}.frame-sm{border:2px solid #121210;box-shadow:3px 3px 0 #121210}.field{border:2px solid #121210;background:#fff;outline:none}.field:focus{box-shadow:0 0 0 3px #2E8C42}.grid-paper{background-image:linear-gradient(rgba(18,18,16,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(18,18,16,.06) 1px,transparent 1px);background-size:24px 24px}\n</style>\n<div class=\"min-h-screen bg-[#CFE8D6] flex flex-col lg:flex-row\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside class=\"w-full lg:w-[250px] shrink-0 border-b-[3px] lg:border-b-0 lg:border-r-[3px] border-[#121210] p-5 flex lg:flex-col gap-4 lg:gap-2 bg-[#CFE8D6]\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex items-center gap-3 lg:mb-8\" data-kid=\"1-1-1\" data-name=\"brand logo lockup\">\n            <div class=\"w-12 h-12 bg-[#2E8C42] frame-sm flex items-center justify-center text-white text-2xl\" data-kid=\"1-1-1-1\" data-name=\"brand logo badge\">\n                <i class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1\" data-name=\"brand building community icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n                <div class=\"display text-xl font-extrabold leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"brand name heading\">\n                    NAGARSEVA\n                </div>\n                <div class=\"mono text-[9px] tracking-widest opacity-60 mt-1\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline text\">\n                    CITIZEN DESK · JHARKHAND\n                </div>\n            </div>\n        </div>\n        <div class=\"hidden lg:block mono text-[10px] tracking-widest opacity-50 px-1 mb-2\" data-kid=\"1-1-2\" data-name=\"workspace section label\">\n            YOUR WORKSPACE\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"flex lg:flex-col gap-2 flex-1\" data-kid=\"1-1-3\" data-name=\"main navigation menu\">\n            <a class=\"frame bg-white flex items-center gap-3 px-3 py-3 font-semibold min-h-11\" data-kid=\"1-1-3-1\" data-name=\"home navigation link\" href=\"#home\">\n                <i class=\"ti ti-home text-xl\" data-kid=\"1-1-3-1-1\" data-name=\"home icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"home navigation label\">\n                    Home\n                </span>\n            </a>\n            <a class=\"frame bg-white flex items-center gap-3 px-3 py-3 font-semibold min-h-11\" data-kid=\"1-1-3-2\" data-name=\"issue list navigation link\" href=\"#issues\">\n                <i class=\"ti ti-list-check text-xl\" data-kid=\"1-1-3-2-1\" data-name=\"issue list checkbox icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"issue list navigation label\">\n                    Issue List\n                </span>\n                <span class=\"mono text-xs ml-auto\" data-kid=\"1-1-3-2-3\" data-name=\"open issue count badge\">\n                    24\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"frame bg-[#E8A030] flex items-center gap-3 px-3 py-3 font-bold min-h-11\" data-kid=\"1-1-3-3\" data-name=\"report issue navigation link active\" href=\"#report\">\n                <i class=\"ti ti-file-plus text-xl\" data-kid=\"1-1-3-3-1\" data-name=\"report issue file-plus icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"report issue navigation label\">\n                    Report Issue\n                </span>\n            </a>\n        </nav>\n        <div class=\"hidden lg:block mt-auto frame bg-white p-3\" data-kid=\"1-1-4\" data-name=\"community status card\">\n            <div class=\"mono text-[9px] tracking-widest opacity-60\" data-kid=\"1-1-4-1\" data-name=\"community status label\">\n                COMMUNITY STATUS\n            </div>\n            <div class=\"display text-xl font-bold mt-2\" data-kid=\"1-1-4-2\" data-name=\"community status headline\">\n                Your voice matters.\n            </div>\n            <p class=\"text-xs mt-1 opacity-70\" data-kid=\"1-1-4-3\" data-name=\"community status description text\">\n                Clear details help local teams respond faster.\n            </p>\n            <div class=\"mt-3 h-2 border-2 border-[#121210]\" data-kid=\"1-1-4-4\" data-name=\"community progress track\">\n                <div class=\"w-2/3 h-full bg-[#2E8C42]\" data-kid=\"1-1-4-4-1\" data-name=\"community progress bar fill\">\n                </div>\n            </div>\n        </div>\n        <div class=\"hidden lg:flex items-center gap-2 mt-3 px-1\" data-kid=\"1-1-5\" data-name=\"user account bar\">\n            <div class=\"w-9 h-9 bg-[#E8A030] frame-sm flex items-center justify-center display font-bold\" data-kid=\"1-1-5-1\" data-name=\"user account avatar badge\">\n                A\n            </div>\n            <div data-kid=\"1-1-5-2\" data-name=\"user account label block\">\n                <div class=\"text-sm font-semibold\" data-kid=\"1-1-5-2-1\" data-name=\"user account name\">\n                    Account\n                </div>\n                <div class=\"mono text-[9px] opacity-60\" data-kid=\"1-1-5-2-2\" data-name=\"user signed-in status text\">\n                    SIGNED IN\n                </div>\n            </div>\n            <button class=\"ml-auto text-sm underline\" data-kid=\"1-1-5-3\" data-name=\"logout button\">\n                Log out\n            </button>\n        </div>\n    </aside>\n    <main class=\"min-w-0 flex-1\" data-kid=\"1-2\" data-name=\"main content area\">\n        <header class=\"border-b-[3px] border-[#121210] px-5 md:px-8 py-4 flex flex-wrap gap-4 items-center justify-between bg-[#CFE8D6]\" data-kid=\"1-2-1\" data-name=\"page header bar\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page header title block\">\n                <div class=\"flex items-center gap-3 flex-wrap\" data-kid=\"1-2-1-1-1\" data-name=\"page title row\">\n                    <h1 class=\"display text-2xl md:text-3xl font-extrabold\" data-kid=\"1-2-1-1-1-1\" data-name=\"page heading title\">\n                        Create New Issue\n                    </h1>\n                    <span class=\"mono border-2 border-[#121210] bg-white px-2 py-1 text-[10px] tracking-wide\" data-kid=\"1-2-1-1-1-2\" data-name=\"step indicator badge\">\n                        STEP 1 OF 1\n                    </span>\n                </div>\n                <p class=\"text-sm mt-1 opacity-70\" data-kid=\"1-2-1-1-2\" data-name=\"page subtitle text\">\n                    Report a local problem and help your community get it resolved.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-2\" data-name=\"header action buttons group\">\n                <button class=\"frame bg-white px-3 py-2 font-semibold text-sm\" data-kid=\"1-2-1-2-1\" data-name=\"how it works button\">\n                    <i class=\"ti ti-help-circle mr-1\" data-kid=\"1-2-1-2-1-1\" data-name=\"help circle icon\">\n                    </i>\n                    How it works\n                </button>\n                <button class=\"frame bg-[#121210] text-white px-4 py-2 font-semibold text-sm\" data-kid=\"1-2-1-2-2\" data-name=\"my reports button\">\n                    My reports\n                    <span class=\"mono ml-1\" data-kid=\"1-2-1-2-2-1\" data-name=\"my reports arrow indicator\">\n                        →\n                    </span>\n                </button>\n            </div>\n        </header>\n        <div class=\"p-4 md:p-7 xl:p-8 grid-paper min-h-[calc(100vh-91px)]\" data-kid=\"1-2-2\" data-name=\"form content section with grid paper background\">\n            <div class=\"max-w-[1150px] mx-auto grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-6 items-start\" data-kid=\"1-2-2-1\" data-name=\"form content grid wrapper\">\n                <section class=\"frame bg-white p-5 md:p-8\" data-kid=\"1-2-2-1-1\" data-name=\"issue report form card\">\n                    <div class=\"flex flex-wrap items-start justify-between gap-4 border-b-[3px] border-[#121210] pb-5\" data-kid=\"1-2-2-1-1-1\" data-name=\"form card header row\">\n                        <div data-kid=\"1-2-2-1-1-1-1\" data-name=\"form card header text block\">\n                            <div class=\"mono text-[10px] tracking-[.16em] text-[#2E8C42] font-bold\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"form eyebrow label\">\n                                NEW COMMUNITY REPORT\n                            </div>\n                            <h2 class=\"display text-2xl font-bold mt-2\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"form card heading\">\n                                Tell us what needs fixing\n                            </h2>\n                            <p class=\"text-sm opacity-70 mt-1\" data-kid=\"1-2-2-1-1-1-1-3\" data-name=\"form card description text\">\n                                Add a photo, location and a few details to get started.\n                            </p>\n                        </div>\n                        <span class=\"border-2 border-[#121210] bg-[#CFE8D6] px-3 py-1 mono text-[10px]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"required fields badge\">\n                            * REQUIRED\n                        </span>\n                    </div>\n                    <form class=\"mt-6 space-y-6\" data-kid=\"1-2-2-1-1-2\" data-name=\"issue report form\">\n                        <fieldset data-kid=\"1-2-2-1-1-2-1\" data-name=\"photo upload fieldset\">\n                            <div class=\"flex items-end justify-between gap-3\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"photo fieldset header row\">\n                                <div data-kid=\"1-2-2-1-1-2-1-1-1\" data-name=\"photo fieldset label block\">\n                                    <legend class=\"display font-bold text-lg\" data-kid=\"1-2-2-1-1-2-1-1-1-1\" data-name=\"photo fieldset legend\">\n                                        1. Add photos\n                                        <span class=\"text-[#C03A3A]\" data-kid=\"1-2-2-1-1-2-1-1-1-1-1\" data-name=\"required asterisk icon\">\n                                            *\n                                        </span>\n                                    </legend>\n                                    <p class=\"text-sm opacity-70 mt-1\" data-kid=\"1-2-2-1-1-2-1-1-1-2\" data-name=\"photo fieldset description text\">\n                                        Show the issue clearly. Up to 10 images.\n                                    </p>\n                                </div>\n                                <span class=\"mono text-[10px] border border-[#121210] px-2 py-1 bg-[#F7F7F2]\" data-kid=\"1-2-2-1-1-2-1-1-2\" data-name=\"photo count indicator\">\n                                    0 / 10\n                                </span>\n                            </div>\n                            <div class=\"mt-3 flex flex-wrap gap-3\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"photo upload actions row\">\n                                <button class=\"frame bg-[#2E8C42] text-white px-4 py-3 flex items-center gap-2 font-bold min-h-12\" data-kid=\"1-2-2-1-1-2-1-2-1\" data-name=\"choose photos upload button\" type=\"button\">\n                                    <i class=\"ti ti-camera-plus text-xl\" data-kid=\"1-2-2-1-1-2-1-2-1-1\" data-name=\"camera plus icon\">\n                                    </i>\n                                    Choose Photos\n                                </button>\n                                <div aria-label=\"Photo preview placeholder\" class=\"w-[94px] h-[94px] frame-sm bg-[#F7F7F2] border-dashed flex items-center justify-center text-3xl opacity-40\" data-kid=\"1-2-2-1-1-2-1-2-2\" data-name=\"photo preview placeholder tile\">\n                                    <i class=\"ti ti-photo\" data-kid=\"1-2-2-1-1-2-1-2-2-1\" data-name=\"photo icon placeholder\">\n                                    </i>\n                                </div>\n                                <div class=\"w-[94px] h-[94px] frame-sm bg-[#F7F7F2] border-dashed flex items-center justify-center text-3xl opacity-30\" data-kid=\"1-2-2-1-1-2-1-2-3\" data-name=\"add photo placeholder tile\">\n                                    <i class=\"ti ti-plus\" data-kid=\"1-2-2-1-1-2-1-2-3-1\" data-name=\"plus icon placeholder\">\n                                    </i>\n                                </div>\n                                <p class=\"self-center text-xs opacity-60 max-w-[180px]\" data-kid=\"1-2-2-1-1-2-1-2-4\" data-name=\"photo preview helper text\">\n                                    Selected photos will appear here. Remove any photo before submitting.\n                                </p>\n                            </div>\n                        </fieldset>\n                        <section aria-label=\"Detected location\" class=\"border-2 border-[#121210] bg-[#CFE8D6] p-4 md:p-5\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"detected location panel\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"location panel content row\">\n                                <div class=\"w-10 h-10 bg-white frame-sm flex items-center justify-center text-[#2E8C42] text-xl shrink-0\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"location icon badge\">\n                                    <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-1-1-2-2-1-1-1\" data-name=\"map pin location icon\">\n                                    </i>\n                                </div>\n                                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-1-2-2-1-2\" data-name=\"location details block\">\n                                    <div class=\"flex items-center flex-wrap gap-2\" data-kid=\"1-2-2-1-1-2-2-1-2-1\" data-name=\"location title row\">\n                                        <h3 class=\"display font-bold\" data-kid=\"1-2-2-1-1-2-2-1-2-1-1\" data-name=\"location title heading\">\n                                            Your location\n                                        </h3>\n                                        <span class=\"mono text-[9px] bg-[#2E8C42] text-white px-2 py-1 tracking-wide\" data-kid=\"1-2-2-1-1-2-2-1-2-1-2\" data-name=\"auto-detected status badge\">\n                                            AUTO-DETECTED\n                                        </span>\n                                    </div>\n                                    <p class=\"text-sm mt-1\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-2-1-2-2\" data-name=\"location fetching status text\" data-reason=\"location text replaced by script once geolocation resolves\">\n                                        Fetching your location…\n                                    </p>\n                                    <p class=\"mono text-[9px] opacity-60 mt-2\" data-kid=\"1-2-2-1-1-2-2-1-2-3\" data-name=\"location permission helper text\">\n                                        LOCATION PERMISSION REQUIRED\n                                    </p>\n                                </div>\n                                <button class=\"underline text-xs font-semibold shrink-0\" data-kid=\"1-2-2-1-1-2-2-1-3\" data-name=\"refresh location button\" type=\"button\">\n                                    Refresh\n                                </button>\n                            </div>\n                        </section>\n                        <div data-kid=\"1-2-2-1-1-2-3\" data-name=\"issue title field group\">\n                            <label class=\"display block font-bold mb-2\" data-kid=\"1-2-2-1-1-2-3-1\" data-name=\"issue title label\" for=\"issue-title\">\n                                2. Issue title\n                                <span class=\"text-[#C03A3A]\" data-kid=\"1-2-2-1-1-2-3-1-1\" data-name=\"required asterisk icon\">\n                                    *\n                                </span>\n                            </label>\n                            <input class=\"field w-full px-4 py-3\" data-kid=\"1-2-2-1-1-2-3-2\" data-name=\"issue title input field\" id=\"issue-title\" placeholder=\"e.g. Streetlight not working on Main Road\" required=\"\"/>\n                            <p class=\"mono text-[9px] opacity-50 mt-2\" data-kid=\"1-2-2-1-1-2-3-3\" data-name=\"issue title character counter\">\n                                BE SPECIFIC · 0 / 100\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-2-1-1-2-4\" data-name=\"issue description field group\">\n                            <label class=\"display block font-bold mb-2\" data-kid=\"1-2-2-1-1-2-4-1\" data-name=\"issue description label\" for=\"issue-description\">\n                                3. Describe the issue\n                                <span class=\"text-[#C03A3A]\" data-kid=\"1-2-2-1-1-2-4-1-1\" data-name=\"required asterisk icon\">\n                                    *\n                                </span>\n                            </label>\n                            <textarea class=\"field w-full px-4 py-3 min-h-[122px] resize-y\" data-kid=\"1-2-2-1-1-2-4-2\" data-name=\"issue description textarea\" id=\"issue-description\" placeholder=\"Tell us what happened, where it is, and when you noticed it…\" required=\"\"></textarea>\n                            <p class=\"text-xs opacity-60 mt-2\" data-kid=\"1-2-2-1-1-2-4-3\" data-name=\"description helper text\">\n                                Helpful details help the right team take action.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-2-1-1-2-5\" data-name=\"issue category field group\">\n                            <label class=\"display block font-bold mb-2\" data-kid=\"1-2-2-1-1-2-5-1\" data-name=\"issue category label\" for=\"issue-category\">\n                                4. Choose a category\n                                <span class=\"text-[#C03A3A]\" data-kid=\"1-2-2-1-1-2-5-1-1\" data-name=\"required asterisk icon\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-2-2-1-1-2-5-2\" data-name=\"category select wrapper\">\n                                <select class=\"field w-full appearance-none px-4 py-3 pr-12 text-[#121210]\" data-kid=\"1-2-2-1-1-2-5-2-1\" data-name=\"category select dropdown\" id=\"issue-category\" required=\"\">\n                                    <option data-kid=\"1-2-2-1-1-2-5-2-1-1\" data-name=\"category default select option\" disabled=\"\" selected=\"\" value=\"\">\n                                        Select the closest match\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-2-5-2-1-2\" data-name=\"roads potholes category option\">\n                                        Roads & potholes\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-2-5-2-1-3\" data-name=\"street lighting category option\">\n                                        Street lighting\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-2-5-2-1-4\" data-name=\"water supply category option\">\n                                        Water supply\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-2-5-2-1-5\" data-name=\"waste sanitation category option\">\n                                        Waste & sanitation\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-2-5-2-1-6\" data-name=\"public safety category option\">\n                                        Public safety\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-2-5-2-1-7\" data-name=\"other category option\">\n                                        Other\n                                    </option>\n                                </select>\n                                <i class=\"ti ti-chevron-down absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none\" data-kid=\"1-2-2-1-1-2-5-2-2\" data-name=\"select chevron down icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"border-t-[3px] border-[#121210] pt-5\" data-kid=\"1-2-2-1-1-2-6\" data-name=\"form submit footer\">\n                            <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\" data-kid=\"1-2-2-1-1-2-6-1\">\n                                <p class=\"text-xs opacity-65 max-w-sm\" data-kid=\"1-2-2-1-1-2-6-1-1\">\n                                    Your report is shared with the relevant local team. You can follow its status in Issue List.\n                                </p>\n                                <button class=\"frame bg-[#B9B9B4] text-[#555] px-6 py-3 font-bold min-h-12 cursor-not-allowed w-full sm:w-auto\" data-kid=\"1-2-2-1-1-2-6-1-2\" disabled=\"\" type=\"button\">\n                                    <i class=\"ti ti-send mr-2\" data-kid=\"1-2-2-1-1-2-6-1-2-1\">\n                                    </i>\n                                    Submit Issue\n                                    <span class=\"mono text-[9px] block font-normal mt-1\" data-kid=\"1-2-2-1-1-2-6-1-2-2\">\n                                        ADD A PHOTO TO CONTINUE\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </form>\n                </section>\n                <aside class=\"space-y-5\" data-kid=\"1-2-2-1-2\">\n                    <section class=\"frame bg-white p-5\" data-kid=\"1-2-2-1-2-1\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-1-2-1-1\">\n                            <h3 class=\"display font-bold text-lg\" data-kid=\"1-2-2-1-2-1-1-1\">\n                                What happens next?\n                            </h3>\n                            <i class=\"ti ti-route text-2xl text-[#2E8C42]\" data-kid=\"1-2-2-1-2-1-1-2\">\n                            </i>\n                        </div>\n                        <ol class=\"mt-5 space-y-4\" data-kid=\"1-2-2-1-2-1-2\">\n                            <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-1-2-1\">\n                                <span class=\"w-8 h-8 bg-[#2E8C42] text-white frame-sm flex items-center justify-center mono text-xs shrink-0\" data-kid=\"1-2-2-1-2-1-2-1-1\">\n                                    01\n                                </span>\n                                <div data-kid=\"1-2-2-1-2-1-2-1-2\">\n                                    <div class=\"font-bold text-sm\" data-kid=\"1-2-2-1-2-1-2-1-2-1\">\n                                        Your report is received\n                                    </div>\n                                    <p class=\"text-xs opacity-65 mt-1\" data-kid=\"1-2-2-1-2-1-2-1-2-2\">\n                                        We record the details and location you share.\n                                    </p>\n                                </div>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-1-2-2\">\n                                <span class=\"w-8 h-8 bg-[#E8A030] frame-sm flex items-center justify-center mono text-xs shrink-0\" data-kid=\"1-2-2-1-2-1-2-2-1\">\n                                    02\n                                </span>\n                                <div data-kid=\"1-2-2-1-2-1-2-2-2\">\n                                    <div class=\"font-bold text-sm\" data-kid=\"1-2-2-1-2-1-2-2-2-1\">\n                                        The local team reviews it\n                                    </div>\n                                    <p class=\"text-xs opacity-65 mt-1\" data-kid=\"1-2-2-1-2-1-2-2-2-2\">\n                                        Your report is routed for review.\n                                    </p>\n                                </div>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-1-2-3\">\n                                <span class=\"w-8 h-8 bg-white frame-sm flex items-center justify-center mono text-xs shrink-0\" data-kid=\"1-2-2-1-2-1-2-3-1\">\n                                    03\n                                </span>\n                                <div data-kid=\"1-2-2-1-2-1-2-3-2\">\n                                    <div class=\"font-bold text-sm\" data-kid=\"1-2-2-1-2-1-2-3-2-1\">\n                                        Track the status\n                                    </div>\n                                    <p class=\"text-xs opacity-65 mt-1\" data-kid=\"1-2-2-1-2-1-2-3-2-2\">\n                                        Follow updates in the issue list.\n                                    </p>\n                                </div>\n                            </li>\n                        </ol>\n                    </section>\n                    <section class=\"frame bg-[#121210] text-white p-5\" data-kid=\"1-2-2-1-2-2\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-2-2-1\">\n                            <i class=\"ti ti-shield-check text-xl text-[#CFE8D6]\" data-kid=\"1-2-2-1-2-2-1-1\">\n                            </i>\n                            <h3 class=\"display font-bold\" data-kid=\"1-2-2-1-2-2-1-2\">\n                                A useful report\n                            </h3>\n                        </div>\n                        <ul class=\"mt-4 space-y-3 text-xs\" data-kid=\"1-2-2-1-2-2-2\">\n                            <li class=\"flex gap-2\" data-kid=\"1-2-2-1-2-2-2-1\">\n                                <i class=\"ti ti-check text-[#CFE8D6]\" data-kid=\"1-2-2-1-2-2-2-1-1\">\n                                </i>\n                                <span data-kid=\"1-2-2-1-2-2-2-1-2\">\n                                    Take a clear, well-lit photo\n                                </span>\n                            </li>\n                            <li class=\"flex gap-2\" data-kid=\"1-2-2-1-2-2-2-2\">\n                                <i class=\"ti ti-check text-[#CFE8D6]\" data-kid=\"1-2-2-1-2-2-2-2-1\">\n                                </i>\n                                <span data-kid=\"1-2-2-1-2-2-2-2-2\">\n                                    Include a nearby landmark\n                                </span>\n                            </li>\n                            <li class=\"flex gap-2\" data-kid=\"1-2-2-1-2-2-2-3\">\n                                <i class=\"ti ti-check text-[#CFE8D6]\" data-kid=\"1-2-2-1-2-2-2-3-1\">\n                                </i>\n                                <span data-kid=\"1-2-2-1-2-2-2-3-2\">\n                                    Describe what needs attention\n                                </span>\n                            </li>\n                        </ul>\n                    </section>\n                    <section class=\"frame bg-[#E8A030] p-4\" data-kid=\"1-2-2-1-2-3\">\n                        <div class=\"mono text-[9px] tracking-widest\" data-kid=\"1-2-2-1-2-3-1\">\n                            YOUR CONTRIBUTION\n                        </div>\n                        <p class=\"display font-bold mt-2\" data-kid=\"1-2-2-1-2-3-2\">\n                            Small details make a big difference.\n                        </p>\n                        <p class=\"text-xs mt-1\" data-kid=\"1-2-2-1-2-3-3\">\n                            Thank you for helping improve your neighborhood.\n                        </p>\n                    </section>\n                </aside>\n                <section class=\"xl:col-span-2 frame bg-[#2E8C42] text-white p-5 md:p-6 mt-1\" data-kid=\"1-2-2-1-3\">\n                    <div class=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-5\" data-kid=\"1-2-2-1-3-1\">\n                        <div class=\"flex items-start gap-4\" data-kid=\"1-2-2-1-3-1-1\">\n                            <div class=\"w-12 h-12 bg-white text-[#2E8C42] frame-sm flex items-center justify-center text-2xl shrink-0\" data-kid=\"1-2-2-1-3-1-1-1\">\n                                <i class=\"ti ti-circle-check\" data-kid=\"1-2-2-1-3-1-1-1-1\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-2-2-1-3-1-1-2\">\n                                <div class=\"mono text-[9px] tracking-[.16em] opacity-80\" data-kid=\"1-2-2-1-3-1-1-2-1\">\n                                    ALTERNATE · AFTER SUBMISSION\n                                </div>\n                                <h3 class=\"display text-2xl font-extrabold mt-1\" data-kid=\"1-2-2-1-3-1-1-2-2\">\n                                    Issue Submitted!\n                                </h3>\n                                <p class=\"text-sm mt-1 opacity-90\" data-kid=\"1-2-2-1-3-1-1-2-3\">\n                                    Your issue has been successfully submitted. Thank you for your feedback.\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"frame bg-[#121210] text-white px-5 py-3 font-bold min-h-12 shrink-0\" data-kid=\"1-2-2-1-3-1-2\">\n                            Go to Home\n                            <i class=\"ti ti-arrow-right ml-2\" data-kid=\"1-2-2-1-3-1-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                </section>\n            </div>\n        </div>\n        <footer class=\"border-t-[3px] border-[#121210] px-5 md:px-8 py-3 flex flex-wrap justify-between gap-3 bg-[#CFE8D6]\" data-kid=\"1-2-3\">\n            <span class=\"mono text-[9px] tracking-widest opacity-60\" data-kid=\"1-2-3-1\">\n                NAGARSEVA · CITIZEN REPORTING\n            </span>\n            <nav aria-label=\"Footer\" class=\"flex gap-5 text-xs font-semibold\" data-kid=\"1-2-3-2\">\n                <a class=\"underline\" data-kid=\"1-2-3-2-1\" href=\"#home\">\n                    Home\n                </a>\n                <a class=\"underline\" data-kid=\"1-2-3-2-2\" href=\"#issues\">\n                    Issue List\n                </a>\n                <a class=\"underline\" data-kid=\"1-2-3-2-3\" href=\"#report\">\n                    Report\n                </a>\n            </nav>\n        </footer>\n    </main>\n</div>\n",

class=\"flex items-center\"><div class=\"w-6 h-1 bg-[#121210]\"></div><div class=\"w-0 h-0\" style=\"border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:8px solid #121210\"></div></div>\n              <div class=\"brut bg-[#E8A030] px-4 py-3 cursor-grab\">\n                <div class=\"font-mono text-[10px] opacity-80\">STAGE 3 · EXEC</div>\n                <div class=\"font-display font-bold\">CFO Review</div>\n                <div class=\"text-[10px] font-mono\">SLA: 72h</div>\n              </div>\n              <div class=\"flex items-center\"><div class=\"w-6 h-1 bg-[#121210]\"></div><div class=\"w-0 h-0\" style=\"border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:8px solid #121210\"></div></div>\n              <div class=\"brut bg-white px-4 py-3 cursor-grab border-dashed\">\n                <div class=\"font-mono text-[10px] opacity-60\">STAGE 4 · COND.</div>\n                <div class=\"font-display font-bold\">Board (≥ $50k)</div>\n                <div class=\"text-[10px] font-mono opacity-60\">Conditional</div>\n              </div>\n              <div class=\"flex items-center\"><div class=\"w-6 h-1 bg-[#121210]\"></div><div class=\"w-0 h-0\" style=\"border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:8px solid #2E8C42\"></div></div>\n              <div class=\"brut bg-[#2E8C42] text-white px-4 py-3\">\n                <div class=\"font-mono text-[10px] opacity-80\">OUTCOME</div>\n                <div class=\"font-display font-bold\">Pay & Post</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- ESCALATION QUEUE -->\n        <div class=\"mt-6 brut overflow-hidden stripes-amber p-1\">\n          <div class=\"bg-[#CFE8D6] p-4\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <div class=\"font-display font-bold text-lg flex items-center gap-2\"><i class=\"ti ti-alert-triangle text-[#C03A3A]
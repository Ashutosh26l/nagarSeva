    "var_6d7e30c7c55d": {
      "type": "variant",
      "label": "NagarSeva — Create Account",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\nbody{font-family:'Hanken Grotesk',sans-serif;background:#CFE8D6;color:#121210}.display{font-family:'Archivo',sans-serif;letter-spacing:-.02em}.mono{font-family:'Space Mono',monospace}.hard{border:3px solid #121210;box-shadow:5px 5px 0 #121210}.hard-sm{border:2px solid #121210;box-shadow:3px 3px 0 #121210}\n</style>\n<div class=\"min-h-screen bg-[#CFE8D6] text-[#121210] flex flex-col\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b-[3px] border-[#121210] px-5 sm:px-8 py-4 flex items-center justify-between bg-[#CFE8D6]\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <a aria-label=\"NagarSeva home\" class=\"flex items-center gap-3 no-underline text-[#121210]\" data-kid=\"1-1-1\" data-name=\"NagarSeva logo link\" href=\"#\">\n            <div class=\"w-12 h-12 bg-[#2E8C42] hard-sm flex items-center justify-center text-white text-2xl\" data-kid=\"1-1-1-1\" data-name=\"logo community building badge\">\n                <i class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1\" data-name=\"community building icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"logo text block\">\n                <div class=\"display font-black text-xl leading-tight\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    NAGARSEVA\n                </div>\n                <div class=\"mono text-[10px] tracking-[.16em] opacity-70\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline text\">\n                    CITIZEN SERVICES · JHARKHAND\n                </div>\n            </div>\n        </a>\n        <div class=\"hidden sm:flex items-center gap-3 mono text-xs\" data-kid=\"1-1-2\" data-name=\"portal status label\">\n            <span class=\"w-2.5 h-2.5 bg-[#2E8C42] border border-[#121210]\" data-kid=\"1-1-2-1\" data-name=\"green status dot indicator\">\n            </span>\n            PUBLIC SERVICE PORTAL\n        </div>\n    </header>\n    <main class=\"flex-1 px-4 sm:px-8 py-8 md:py-12 flex items-center justify-center\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"w-full max-w-[1080px] grid md:grid-cols-[.92fr_1.08fr] gap-8 md:gap-12 items-center\" data-kid=\"1-2-1\" data-name=\"two column hero grid\">\n            <section class=\"max-w-md mx-auto md:mx-0\" data-kid=\"1-2-1-1\" data-name=\"hero intro section\">\n                <div class=\"inline-flex items-center gap-2 border-2 border-[#121210] bg-white px-3 py-2 mono text-[10px] tracking-[.12em] hard-sm\" data-kid=\"1-2-1-1-1\" data-name=\"shield-check trust badge\">\n                    <i class=\"ti ti-shield-check text-[#2E8C42] text-base\" data-kid=\"1-2-1-1-1-1\" data-name=\"shield check icon\">\n                    </i>\n                    ONE ACCOUNT. YOUR CITY.\n                </div>\n                <h1 class=\"display font-black text-4xl sm:text-5xl leading-[1.02] mt-6\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline text\">\n                    Make your\n                    <br data-kid=\"1-2-1-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#2E8C42]\" data-kid=\"1-2-1-1-2-2\" data-name=\"highlighted portion of headline\">\n                        voice count.\n                    </span>\n                </h1>\n                <p class=\"text-lg leading-relaxed mt-5 max-w-[420px]\" data-kid=\"1-2-1-1-3\" data-name=\"hero supporting paragraph\">\n                    Create an account to report local issues, follow their progress, and help make your community better.\n                </p>\n                <div class=\"mt-8 border-l-[5px] border-[#2E8C42] pl-4 py-1\" data-kid=\"1-2-1-1-4\" data-name=\"how-it-works steps list\">\n                    <div class=\"mono text-[10px] tracking-[.14em] opacity-60\" data-kid=\"1-2-1-1-4-1\" data-name=\"steps list heading\">\n                        HOW NAGARSEVA WORKS\n                    </div>\n                    <div class=\"mt-3 flex items-start gap-3\" data-kid=\"1-2-1-1-4-2\" data-name=\"step one row\">\n                        <div class=\"w-8 h-8 shrink-0 bg-[#2E8C42] border-2 border-[#121210] text-white display font-bold flex items-center justify-center\" data-kid=\"1-2-1-1-4-2-1\" data-name=\"step one number badge\">\n                            01\n                        </div>\n                        <div data-kid=\"1-2-1-1-4-2-2\" data-name=\"step one text block\">\n                            <div class=\"display font-bold\" data-kid=\"1-2-1-1-4-2-2-1\" data-name=\"step one title\">\n                                Report an issue\n                            </div>\n                            <div class=\"text-sm opacity-75\" data-kid=\"1-2-1-1-4-2-2-2\" data-name=\"step one description\">\n                                Share a photo and location.\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex items-start gap-3\" data-kid=\"1-2-1-1-4-3\" data-name=\"step two row\">\n                        <div class=\"w-8 h-8 shrink-0 bg-[#F0A52D] border-2 border-[#121210] display font-bold flex items-center justify-center\" data-kid=\"1-2-1-1-4-3-1\" data-name=\"step two number badge\">\n                            02\n                        </div>\n                        <div data-kid=\"1-2-1-1-4-3-2\" data-name=\"step two text block\">\n                            <div class=\"display font-bold\" data-kid=\"1-2-1-1-4-3-2-1\" data-name=\"step two title\">\n                                Track the response\n                            </div>\n                            <div class=\"text-sm opacity-75\" data-kid=\"1-2-1-1-4-3-2-2\" data-name=\"step two description\">\n                                See updates from your community.\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-8 flex gap-2 items-center mono text-[10px] opacity-70\" data-kid=\"1-2-1-1-5\" data-name=\"location trust footer line\">\n                    <i class=\"ti ti-map-pin text-lg text-[#2E8C42]\" data-kid=\"1-2-1-1-5-1\" data-name=\"map pin icon\">\n                    </i>\n                    BUILT FOR CITIZENS ACROSS JHARKHAND\n                </div>\n            </section>\n            <section class=\"w-full max-w-[520px] mx-auto\" data-kid=\"1-2-1-2\" data-name=\"registration section\">\n                <div class=\"bg-white hard p-6 sm:p-9 relative\" data-kid=\"1-2-1-2-1\" data-name=\"signup card with border and shadow\">\n                    <div class=\"absolute -top-3 left-5 bg-[#F0A52D] border-2 border-[#121210] px-3 py-1 mono text-[10px] font-bold tracking-wider\" data-kid=\"1-2-1-2-1-1\" data-name=\"new citizen account badge\">\n                        NEW CITIZEN ACCOUNT\n                    </div>\n                    <div class=\"mt-3 flex justify-between items-start gap-4\" data-kid=\"1-2-1-2-1-2\" data-name=\"card header row\">\n                        <div data-kid=\"1-2-1-2-1-2-1\" data-name=\"card header text block\">\n                            <div class=\"mono text-[10px] tracking-[.15em] opacity-55\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"card section label\">\n                                GET STARTED\n                            </div>\n                            <h2 class=\"display text-3xl sm:text-4xl font-black mt-1\" data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"card heading\">\n                                Create account\n                            </h2>\n                        </div>\n                        <div class=\"w-12 h-12 hidden sm:flex items-center justify-center bg-[#CFE8D6] border-2 border-[#121210] text-[#2E8C42] text-2xl\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"card header icon badge\">\n                            <i class=\"ti ti-user-plus\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"user plus icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <p class=\"mt-3 text-sm text-[#454640]\" data-kid=\"1-2-1-2-1-3\" data-name=\"card description text\">\n                        Enter your details to join your local issue tracker.\n                    </p>\n                    <form aria-label=\"Create NagarSeva account\" class=\"mt-7 space-y-5\" data-kid=\"1-2-1-2-1-4\" data-name=\"signup form\">\n                        <div data-kid=\"1-2-1-2-1-4-1\" data-name=\"username field group\">\n                            <label class=\"block display font-bold text-sm mb-2\" data-kid=\"1-2-1-2-1-4-1-1\" data-name=\"username field label\" for=\"username\">\n                                Username\n                            </label>\n                            <input class=\"w-full min-h-12 px-4 border-2 border-[#121210] bg-[#FAFCFA] placeholder:text-[#74766F] focus:outline-2 focus:outline-offset-2 focus:outline-[#2E8C42]\" data-kid=\"1-2-1-2-1-4-1-2\" data-name=\"username input field\" id=\"username\" placeholder=\"Choose a username\" required=\"\" type=\"text\"/>\n                            <p class=\"mono text-[10px] mt-2 opacity-55\" data-kid=\"1-2-1-2-1-4-1-3\" data-name=\"username helper text\">\n                                YOUR NAME IN THE COMMUNITY\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-2-1-4-2\" data-name=\"password field group\">\n                            <label class=\"block display font-bold text-sm mb-2\" data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"password field label\" for=\"password\">\n                                Password\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-2-1-2-1-4-2-2\" data-name=\"password input wrapper\">\n                                <input class=\"w-full min-h-12 px-4 pr-12 border-2 border-[#121210] bg-[#FAFCFA] placeholder:text-[#74766F] focus:outline-2 focus:outline-offset-2 focus:outline-[#2E8C42]\" data-kid=\"1-2-1-2-1-4-2-2-1\" data-name=\"password input field\" id=\"password\" placeholder=\"Create a password\" required=\"\" type=\"password\"/>\n                                <i class=\"ti ti-lock absolute right-4 top-1/2 -translate-y-1/2 text-lg opacity-55\" data-kid=\"1-2-1-2-1-4-2-2-2\" data-name=\"lock icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-2-1-4-3\" data-name=\"confirm password field group\">\n                            <label class=\"block display font-bold text-sm mb-2\" data-kid=\"1-2-1-2-1-4-3-1\" data-name=\"confirm password field label\" for=\"confirmPassword\">\n                                Confirm Password\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-2-1-2-1-4-3-2\" data-name=\"confirm password input wrapper\">\n                                <input aria-describedby=\"password-error\" aria-invalid=\"true\" class=\"w-full min-h-12 px-4 pr-12 border-[3px] border-[#C03A3A] bg-[#FFF9F7] placeholder:text-[#74766F] focus:outline-2 focus:outline-offset-2 focus:outline-[#C03A3A]\" data-kid=\"1-2-1-2-1-4-3-2-1\" data-name=\"confirm password input field\" id=\"confirmPassword\" placeholder=\"Confirm your password\" required=\"\" type=\"password\"/>\n                                <i class=\"ti ti-alert-circle absolute right-4 top-1/2 -translate-y-1/2 text-xl text-[#C03A3A]\" data-kid=\"1-2-1-2-1-4-3-2-2\" data-name=\"alert circle icon\">\n                                </i>\n                            </div>\n                            <p class=\"mt-2 flex items-center gap-2 bg-[#FCE8E5] border-2 border-[#C03A3A] px-3 py-2 text-sm font-semibold text-[#792323]\" data-kid=\"1-2-1-2-1-4-3-3\" data-name=\"password mismatch error message\" id=\"password-error\" role=\"alert\">\n                                <i class=\"ti ti-alert-triangle text-lg\" data-kid=\"1-2-1-2-1-4-3-3-1\" data-name=\"alert triangle icon\">\n                                </i>\n                                Passwords do not match\n                            </p>\n                        </div>\n                        <button class=\"w-full min-h-12 bg-[#2E8C42] border-[3px] border-[#121210] shadow-[4px_4px_0_#121210] px-5 py-3 text-white display font-bold tracking-wide hover:bg-[#267637] active:translate-x-1 active:translate-y-1 active:shadow-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#121210]\" data-kid=\"1-2-1-2-1-4-4\" data-name=\"sign up submit button\" type=\"button\">\n                            Sign Up\n                            <i class=\"ti ti-arrow-right ml-2 text-lg align-middle\" data-kid=\"1-2-1-2-1-4-4-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </button>\n                    </form>\n                    <div class=\"mt-5 bg-[#E4F1E6] border-2 border-[#2E8C42] px-4 py-3 flex items-start gap-3\" data-kid=\"1-2-1-2-1-5\" data-name=\"success status message\" role=\"status\">\n                        <div class=\"w-8 h-8 shrink-0 bg-[#2E8C42] text-white border-2 border-[#121210] flex items-center justify-center\" data-kid=\"1-2-1-2-1-5-1\" data-name=\"success checkmark badge\">\n                            <i class=\"ti ti-check text-xl\" data-kid=\"1-2-1-2-1-5-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-1-2-1-5-2\" data-name=\"success status text block\">\n                            <div class=\"display font-bold text-sm\" data-kid=\"1-2-1-2-1-5-2-1\" data-name=\"success status title\">\n                                Account created\n                            </div>\n                            <div class=\"text-sm text-[#23482B]\" data-kid=\"1-2-1-2-1-5-2-2\" data-name=\"success status detail\">\n                                User [name] created successfully.\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-6 pt-5 border-t-2 border-dashed border-[#121210]/30 text-center\" data-kid=\"1-2-1-2-1-6\" data-name=\"login link section\">\n                        <p class=\"text-sm text-[#555750]\" data-kid=\"1-2-1-2-1-6-1\" data-name=\"already have account text\">\n                            Already have an account?\n                        </p>\n                        <a class=\"inline-flex min-h-11 items-center justify-center mt-1 px-2 font-bold text-[#267637] underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#121210]\" data-kid=\"1-2-1-2-1-6-2\" data-name=\"back to login link\" href=\"#\">\n                            Back to login\n                            <i class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-2-1-2-1-6-2-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex justify-between items-center px-1 mono text-[9px] tracking-wider opacity-55\" data-kid=\"1-2-1-2-2\" data-name=\"form meta bar\">\n                    <span data-kid=\"1-2-1-2-2-1\" data-name=\"form meta label\">\n                        FORM · CITIZEN REGISTRATION\n                    </span>\n                    <span data-kid=\"1-2-1-2-2-2\" data-name=\"form step indicator\">\n                        01 / 01\n                    </span>\n                </div>\n            </section>\n        </div>\n    </main>\n    <footer class=\"border-t-[3px] border-[#121210] px-5 sm:px-8 py-3 flex flex-wrap items-center justify-between gap-2 bg-[#CFE8D6]\" data-kid=\"1-3\" data-name=\"site footer bar\">\n        <span class=\"mono text-[10px] tracking-wider\" data-kid=\"1-3-1\" data-name=\"footer brand text\">\n            NAGARSEVA · JHARKHAND\n        </span>\n        <nav aria-label=\"Main navigation\" class=\"flex items-center gap-2 sm:gap-5 text-sm\" data-kid=\"1-3-2\" data-name=\"footer main navigation\">\n            <a class=\"min-h-11 inline-flex items-center px-2 font-semibold hover:underline\" data-kid=\"1-3-2-1\" data-name=\"home nav link\" href=\"#\">\n                Home\n            </a>\n            <a class=\"min-h-11 inline-flex items-center px-2 font-semibold hover:underline\" data-kid=\"1-3-2-2\" data-name=\"issue list nav link\" href=\"#\">\n                Issue List\n            </a>\n            <a class=\"min-h-11 inline-flex items-center px-2 font-semibold hover:underline\" data-kid=\"1-3-2-3\" data-name=\"report nav link\" href=\"#\">\n                Report\n            </a>\n            <span class=\"min-h-11 inline-flex items-center px-4 bg-[#121210] text-white display font-bold\" data-kid=\"1-3-2-4\" data-name=\"login button-style nav item\">\n                Login\n            </span>\n        </nav>\n    </footer>\n</div>\n",
      "comments": [],

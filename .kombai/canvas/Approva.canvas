able hard bg-[#CFE8D6] px-3 py-2 font-bold text-sm\" data-kid=\"1-2-2-2-1-3-2-5-1\" data-name=\"upvote support button\">\n                                    <i class=\"ti ti-arrow-big-up mr-1\" data-kid=\"1-2-2-2-1-3-2-5-1-1\" data-name=\"up arrow icon\">\n                                    </i>\n                                    38\n                                    <span class=\"font-normal\" data-kid=\"1-2-2-2-1-3-2-5-1-2\" data-name=\"support label\">\n                                        support\n                                    </span>\n                                </button>\n                                <button class=\"focusable font-bold text-sm underline underline-offset-4\" data-kid=\"1-2-2-2-1-3-2-5-2\" data-name=\"view details button\">\n                                    View details\n                                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-1-3-2-5-2-1\" data-name=\"external link arrow icon\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"count-box min-w-[90px] self-center border-l-2 border-[#121210]/20 pl-4 text-center\" data-kid=\"1-2-2-2-1-3-3\" data-name=\"nearby citizens count box\">\n                            <div class=\"eyebrow opacity-45\" data-kid=\"1-2-2-2-1-3-3-1\" data-name=\"citizen label\">\n                                Citizen\n                            </div>\n                            <div class=\"flex justify-center -space-x-2 mt-2\" data-kid=\"1-2-2-2-1-3-3-2\" data-name=\"avatar stack\">\n                                <span class=\"w-8 h-8 rounded-full bg-[#E8A030] border-2 border-white flex items-center justify-center text-xs font-bold\" data-kid=\"1-2-2-2-1-3-3-2-1\" data-name=\"first citizen avatar\">\n                                    R\n                                </span>\n                                <span class=\"
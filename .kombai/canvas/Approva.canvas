div>\n        </div>\n\n      </section>\n    </div>\n  </main>\n</div>\n\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script type=\"module\">\n  import { animate, spring } from 'https://esm.sh/animejs@4';\n\n  // entrance\n  gsap.from('.req-card', { autoAlpha: 0, y: 24, duration: 0.5, ease: 'power3.out', stagger: 0.06 });\n  gsap.from('#invoice', { autoAlpha: 0, y: 20, duration: 0.6, ease: 'power3.out', delay: 0.15 });\n  gsap.from('.stamp-btn', { autoAlpha: 0, x: 30, duration: 0.5, ease: 'power3.out', stagger: 0.08, delay: 0.3 });\n\n  const drop = document.getElementById('stamp-drop');\n  const invoice = document.getElementById('invoice');\n\n  function dropStamp(label, color){\n    drop.innerHTML = '';\n    const el = document.createElement('div');\n    el.className = 'big-stamp';\n    el.textContent = label;\n    el.style.color = color;\n    el.style.transform = 'scale(3) rotate(-15deg)';\n    el.style.opacity = '0';\n    drop.appendChild(el);\n\n    animate(el, {\n      scale: [3, 1],\n      rotate: [-15, -6],\n      opacity: [0, 0.88],\n      duration: 600,\n      ease: spring({ stiffness: 90, damping: 8, mass: 1.4 })\n    });\n    animate(invoice, {\n      x: [0, -8, 6, -4, 2, 0],\n      duration: 600,\n      ease: 'outElastic(1, 0.5)'\n    });\n  }\n\n  document.getElementById('btn-approve').addEventListener('click', ()=> dropStamp('APPROVED','#2E8C42'));\n  document.getElementById('btn-reject').addEventListener('click', ()=> dropStamp('REJECTED','#C03A3A'));\n  document.getElementById('btn-detail').addEventListener('click', ()=> dropStamp('NEEDS DETAIL','#E8A030'));\n</script>\n  ",

      "html": "\n    <style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\nbody { font-family: 'Hanken Grotesk', sans-serif; background:#CFE8D6; color:#121210; }\n.font-display { font-family: 'Archivo', sans-serif; letter-spacing:-0.01em; }\n.font-mono { font-family: 'Space Mono', monospace; font-variant-numeric: tabular-nums; }\n.brut { border: 3px solid #121210; box-shadow: 4px 4px 0 #121210; }\n.brut-lg { border: 3px solid #121210; box-shadow: 6px 6px 0 #121210; }\n.brut-sm { border: 2px solid #121210; box-shadow: 3px 3px 0 #121210; }\n.brut-card { border: 3px solid #121210; box-shadow: 4px 4px 0 #121210; background:#FFFFFF; }\n.brut-card:hover { transform: translate(-2px,-2px); box-shadow: 8px 8px 0 #121210; }\n.btn-press:active { transform: translate(4px,4px); box-shadow: 0 0 0 #121210 !important; }\n.stripes-amber { background-image: repeating-linear-gradient(45deg, #F4D89A, #F4D89A 12px, #E8A030 12px, #E8A030 14px); }\n.grid-paper { background-image: linear-gradient(rgba(18,18,16,0.08) 1px,transparent 1px),linear-gradient(90deg,rgba(18,18,16,0.08) 1px,transparent 1px); background-size: 24px 24px; }\n.polka { background-image: radial-gradient(circle,#121210 1.5px,transparent 1.5px); background-size: 20px 20px; }\n.tab-active { background:#121210; color:#FFFFFF; }\n.nav-item:hover { transform: translate(-1px,-1px); box-shadow: 5px 5px 0 #121210; }\n\n/* Stamp */\n.stamp {\n  font-family: 'Archivo', sans-serif;\n  font-weight: 700;\n  border: 4px solid currentColor;\n  padding: 10px 22px;\n  letter-spacing: 0.15em;\n  display: inline-block;\n  border-radius: 4px;\n  position: relative;\n}\n.stamp::before, .stamp::after {\n  content:\"\"; position:absolute; inset:4px; border: 2px solid currentColor; border-radius:2px; opacity:.6;\n}\n.stamp::after { inset:-2px; border:2px dashed currentColor; opacity:.35; }\n\n/* Keep every history column readable inside the document pane. */\n.history-table { table-layout:fixed; }\n.history-table th, .history-table td { padding:10px 6px; overflow-wrap:anywhere; }\n.history-table th { font-size:10px; letter-spacing:.06em; }\n.history-table td { font-size:12px; }\n.history-table .stamp { padding:6px 4px; border-width:2px; font-size:9px; letter-spacing:.06em; white-space:normal; text-align:center; max-width:100%; }\n.req-card > .flex:first-of-type { gap:12px; }\n.req-card > .flex:first-of-type > div:first-child { min-width:0; }\n.req-card > .flex:first-of-type > div:last-child { flex-shrink:0; }\n@media (max-width:1350px) {\n  .document-layout { flex-direction:column; }\n  .document-layout > #invoice { width:100%; flex:none; }\n  .document-actions { position:static; width:100%; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }\n  .document-actions > * { margin:0; }\n  .document-actions > div { grid-column:1 / -1; }\n  .document-actions .stamp-btn { padding:14px 6px; font-size:12px; letter-spacing:.05em; min-width:0; }\n}\n\n.big-stamp {\n  position:absolute;\n  font-family:'Archivo',sans-serif;\n  font-weight:700;\n  font-size:64px;\n  letter-spacing:0.12em;\n  border: 8px solid currentColor;\n  padding: 16px 36px;\n  border-radius: 6px;\n  opacity: 0.88;\n  pointer-events:none;\n}\n\n.tag { display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border:2px solid #121210; font-weight:600; font-size:11px; letter-spacing:0.06em; text-transform:uppercase; }\n\n.chain-node { width:28px; height:28px; border:2px solid #121210; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; }\n.chain-line { width:18px; height:3px; background:#121210; }\n\n.stamp-btn { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; padding:18px 14px; border:3px solid #121210; box-shadow: 4px 4px 0 #121210; cursor:pointer; font-family:'Archivo'; font-weight:700; letter-spacing:0.1em; }\n.stamp-btn:active { transform: translate(4px,4px); box-shadow: 0 0 0 #121210; }\n\ninput:focus, button:focus { outline: none; }\n</style>\n\n<div class=\"min-h-screen flex\">\n\n  <!-- SIDEBAR -->\n  <aside class=\"w-[260px] shrink-0 bg-[#CFE8D6] border-r-[3px] border-[#121210] p-5 flex flex-col gap-2\">\n    <div class=\"flex items-center gap-2 mb-6\">\n      <div class=\"w-11 h-11 bg-[#2E8C42] brut-sm flex items-center justify-center\">\n        <i class=\"ti ti-stamp text-[#FFFFFF] text-2xl\"></i>\n      </div>\n      <div>\n        <div class=\"font-display font-bold text-lg leading-none\">STAMPLY</div>\n        <div class=\"text-[10px] font-mono tracking-widest opacity-60\">v2.4 · LEDGER</div>\n      </div>\n    </div>\n\n    <div class=\"text-[10px] font-mono tracking-widest opacity-50 mb-2 px-1\">WORKSPACE</div>\n\n    <a class=\"nav-item brut bg-[#FFFFFF] flex items-center justify-between p-3 cursor-pointer\">\n      <span class=\"flex items-center gap-3 font-display font-semibold\"><i class=\"ti ti-inbox text-xl\"></i>Inbox</span>\n      <span class=\"bg-[#121210] text-[#FFFFFF] font-mono text-xs px-2 py-0.5\">12</span>\n    </a>\n    <a class=\"nav-item brut bg-[#E8A030] flex items-center justify-between p-3 cursor-pointer\">\n      <span class=\"flex items-center gap-3 font-display font-semibold\"><i class=\"ti ti-flame text-xl\"></i>Escalations</span>\n      <span class=\"bg-[#C03A3A] text-[#FFFFFF] font-mono text-xs px-2 py-0.5\">3</span>\n    </a>\n    <a class=\"nav-item brut bg-[#FFFFFF] flex items-center justify-between p-3 cursor-pointer\">\n      <span class=\"flex items-center gap-3 font-display font-semibold\"><i class=\"ti ti-archive text-xl\"></i>History</span>\n      <span class=\"font-mono text-xs opacity-60\">2,481</span>\n    </a>\n    <a class=\"nav-item brut bg-[#FFFFFF] flex items-center gap-3 p-3 cursor-pointer font-display font-semibold\">\n      <i class=\"ti ti-git-merge text-xl\"></i>Workflow Builder\n    </a>\n\n    <div class=\"mt-auto\">\n      <div class=\"brut bg-[#FFFFFF] p-3\">\n        <div class=\"text-[10px] font-mono tracking-widest opacity-60 mb-1\">TODAY · STAMPED</div>\n        <div class=\"flex items-end gap-2\">\n          <div class=\"font-mono font-bold text-3xl\">47</div>\n          <div class=\"text-xs opacity-60 mb-1\">of 59 pending</div>\n        </div>\n        <div class=\"mt-2 h-3 border-2 border-[#121210] flex overflow-hidden\">\n          <div class=\"bg-[#2E8C42] w-[60%]\"></div>\n          <div class=\"bg-[#C03A3A] w-[15%]\"></div>\n          <div class=\"bg-[#E8A030] w-[10%]\"></div>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-2 mt-3 p-2\">\n        <img src=\"https://i.pravatar.cc/64?u=mara\" class=\"w-9 h-9 border-2 border-[#121210]\" decoding=\"async\" loading=\"lazy\" / onerror=\"__crawlAsset&&__crawlAsset(this)\">\n        <div>\n          <div class=\"text-sm font-semibold leading-tight\">Mara Vossberg</div>\n          <div class=\"text-[10px] font-mono opacity-60\">CFO · APPROVER</div>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  <!-- MAIN -->\n  <main class=\"flex-1 flex flex-col min-w-0\">\n\n    <!-- TOP BAR -->\n    <header class=\"border-b-[3px] border-[#121210] bg-[#CFE8D6] px-6 py-4 flex items-center justify-between\">\n      <div>\n        <div class=\"flex items-center gap-3\">\n          <h1 class=\"font-display font-bold text-3xl\">Approver Inbox</h1>\n          <span class=\"tag bg-[#FFFFFF]\">12 PENDING</span>\n          <span class=\"tag bg-[#C03A3A] text-[#FFFFFF] border-[#121210]\">3 PAST SLA</span>\n        </div>\n        <div class=\"text-xs font-mono opacity-60 mt-1\">FRI · 14 MAR 2025 · 09:42:18 UTC</div>\n      </div>\n      <div class=\"flex gap-2\">\n        <div class=\"brut bg-[#FFFFFF] flex items-center gap-2 px-3 py-2 w-72\">\n          <i class=\"ti ti-search\"></i>\n          <input class=\"bg-transparent flex-1 text-sm\" placeholder=\"Search vendor, PO#, requester…\" />\n          <span class=\"font-mono text-[10px] border border-[#121210] px-1\">⌘K</span>\n        </div>\n        <button class=\"brut bg-[#121210] text-[#FFFFFF] px-4 font-display font-semibold btn-press\">+ NEW REQUEST</button>\n      </div>\n    </header>\n\n    <!-- TABS -->\n    <div class=\"px-6 pt-4 flex gap-0 border-b-[3px] border-[#121210] bg-[#CFE8D6]\">\n      <button class=\"tab-active font-display font-semibold px-5 py-2 border-[3px] border-[#121210] border-b-0 -mb-[3px]\">Inbox</button>\n      <button class=\"font-display font-semibold px-5 py-2 border-[3px] border-[#121210] border-l-0 border-b-0 -mb-[3px] bg-[#FFFFFF]\">Escalations</button>\n      <button class=\"font-display font-semibold px-5 py-2 border-[3px] border-[#121210] border-l-0 border-b-0 -mb-[3px] bg-[#FFFFFF]\">History</button>\n      <button class=\"font-display font-semibold px-5 py-2 border-[3px] border-[#121210] border-l-0 border-b-0 -mb-[3px] bg-[#FFFFFF]\">Workflow Builder</button>\n    </div>\n\n    <!-- SPLIT: list + detail -->\n    <div class=\"flex flex-1 min-h-0\">\n\n      <!-- LIST -->\n      <section class=\"w-[44%] border-r-[3px] border-[#121210] p-5 space-y-4 overflow-y-auto bg-[#CFE8D6]\">\n\n        <div class=\"flex items-center justify-between text-xs font-mono\">\n          <div class=\"flex gap-2\">\n            <button class=\"brut-sm bg-[#FFFFFF] px-2 py-1\">ALL</button>\n            <button class=\"px-2 py-1 opacity-60\">EXPENSES</button>\n            <button class=\"px-2 py-1 opacity-60\">PO</button>\n          </div>\n          <span class=\"opacity-60\">SORT: OLDEST FIRST ↓</span>\n        </div>\n\n        <!-- selected card -->\n        <article class=\"req-card brut-card p-4 relative cursor-pointer\" style=\"background:#FFFFFF;\">\n          <span class=\"absolute -top-2 -left-2 bg-[#E8A030] border-2 border-[#121210] px-2 py-0.5 text-[10px] font-mono font-bold\">PO-2025-0418</span>\n          <div class=\"flex justify-between items-start\">\n            <div>\n              <div class=\"font-display font-bold text-xl leading-tight\">Helvetica Logistics Co.</div>\n              <div class=\"text-xs opacity-70 mt-0.5\">Q1 Warehouse Rack Replacement · 14 line items</div>\n            </div>\n            <div class=\"text-right\">\n              <div class=\"font-mono font-bold text-2xl\">$48,920.00</div>\n              <div class=\"text-[10px] font-mono opacity-60\">USD · NET-30</div>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 mt-3 flex-wrap\">\n            <span class=\"tag bg-[#CFE8D6]\">CAPEX</span>\n            <span class=\"tag bg-[#FFFFFF]\">PURCHASE ORDER</span>\n            <span class=\"tag bg-[#E8A030]\"><i class=\"ti ti-clock text-xs\"></i>3D LEFT</span>\n          </div>\n          <div class=\"flex items-center justify-between mt-4\">\n            <div class=\"flex items-center gap-2\">\n              <img src=\"https://i.pravatar.cc/40?u=devin\" class=\"w-7 h-7 border-2 border-[#121210]\" decoding=\"async\" loading=\"lazy\"/ onerror=\"__crawlAsset&&__crawlAsset(this)\">\n              <div class=\"text-xs\"><span class=\"font-semibold\">Devin Park</span><br/><span class=\"opacity-60 font-mono text-[10px]\">OPS · SUBMITTED 09:11</span></div>\n            </div>\n            <div class=\"flex items-center\">\n              <span class=\"chain-node bg-[#2E8C42] text-white\">✓</span>\n              <span class=\"chain-line\"></span>\n              <span class=\"chain-node bg-[#2E8C42] text-white\">✓</span>\n              <span class=\"chain-line\"></span>\n              <span class=\"chain-node bg-[#E8A030]\">M</span>\n              <span class=\"chain-line\"></span>\n              <span class=\"chain-node bg-[#FFFFFF] opacity-50\">·</span>\n            </div>\n          </div>\n        </article>\n\n        <!-- other cards -->\n        <article class=\"req-card brut-card p-4 relative cursor-pointer\">\n          <span class=\"absolute -top-2 -left-2 bg-[#FFFFFF] border-2 border-[#121210] px-2 py-0.5 text-[10px] font-mono font-bold\">EXP-9921</span>\n          <div class=\"flex justify-between items-start\">\n            <div>\n              <div class=\"font-display font-bold text-xl leading-tight\">Figma Inc.</div>\n              <div class=\"text-xs opacity-70 mt-0.5\">Annual team seat renewal · 22 seats</div>\n            </div>\n            <div class=\"text-right\">\n              <div class=\"font-mono font-bold text-2xl\">$3,960.00</div>\n              <div class=\"text-[10px] font-mono opacity-60\">USD · CARD</div>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 mt-3 flex-wrap\">\n            <span class=\"tag bg-[#CFE8D6]\">SOFTWARE</span>\n            <span class=\"tag bg-[#FFFFFF]\">EXPENSE</span>\n          </div>\n          <div class=\"flex items-center justify-between mt-4\">\n            <div class=\"flex items-center gap-2\">\n              <img src=\"https://i.pravatar.cc/40?u=lena\" class=\"w-7 h-7 border-2 border-[#121210]\" decoding=\"async\" loading=\"lazy\"/ onerror=\"__crawlAsset&&__crawlAsset(this)\">\n              <div class=\"text-xs\"><span class=\"font-semibold\">Lena Akhtar</span><br/><span class=\"opacity-60 font-mono text-[10px]\">DESIGN · 08:47</span></div>\n            </div>\n            <div class=\"flex items-center\">\n              <span class=\"chain-node bg-[#2E8C42] text-white\">✓</span>\n              <span class=\"chain-line\"></span>\n              <span class=\"chain-node bg-[#E8A030]\">M</span>\n              <span class=\"chain-line\"></span>\n              <span class=\"chain-node bg-[#FFFFFF] opacity-50\">·</span>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"req-card brut-card p-4 relative cursor-pointer\">\n          <span class=\"absolute -top-2 -left-2 bg-[#C03A3A] text-[#FFFFFF] border-2 border-[#121210] px-2 py-0.5 text-[10px] font-mono font-bold\">⚠ PO-2025-0402</span>\n          <div class=\"flex justify-between items-start\">\n            <div>\n              <div class=\"font-display font-bold text-xl leading-tight\">Brunswick Catering Ltd.</div>\n              <div class=\"text-xs opacity-70 mt-0.5\">Off-site quarterly event · Q1</div>\n            </div>\n            <div class=\"text-right\">\n              <div class=\"font-mono font-bold text-2xl\">$12,480.50</div>\n              <div class=\"text-[10px] font-mono opacity-60\">USD · INVOICE</div>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 mt-3 flex-wrap\">\n            <span class=\"tag bg-[#CFE8D6]\">EVENTS</span>\n            <span class=\"tag bg-[#C03A3A] text-[#FFFFFF]\"><i class=\"ti ti-flame text-xs\"></i>ESCALATED</span>\n            <span class=\"tag bg-[#FFFFFF]\">+2 DAYS LATE</span>\n          </div>\n          <div class=\"flex items-center justify-between mt-4\">\n            <div class=\"flex items-center gap-2\">\n              <img src=\"https://i.pravatar.cc/40?u=marco\" class=\"w-7 h-7 border-2 border-[#121210]\" decoding=\"async\" loading=\"lazy\"/ onerror=\"__crawlAsset&&__crawlAsset(this)\">\n              <div class=\"text-xs\"><span class=\"font-semibold\">Marco Reyes</span><br/><span class=\"opacity-60 font-mono text-[10px]\">PEOPLE OPS · 11 MAR</span></div>\n            </div>\n            <div class=\"flex items-center\">\n              <span class=\"chain-node bg-[#2E8C42] text-white\">✓</span>\n              <span class=\"chain-line\"></span>\n              <span class=\"chain-node bg-[#C03A3A] text-white\">!</span>\n              <span class=\"chain-line\"></span>\n              <span class=\"chain-node bg-[#FFFFFF] opacity-50\">·</span>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"req-card brut-card p-4 relative cursor-pointer\">\n          <span class=\"absolute -top-2 -left-2 bg-